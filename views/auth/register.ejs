<% layout('layouts/boilerplate') %>
<%
    const captchaSettings = typeof captcha !== 'undefined' && captcha ? captcha : { provider: 'hcaptcha', configured: false, siteKey: '' };
    const registrationMessage = typeof registrationError !== 'undefined' ? registrationError : '';
%>

<% if (captchaSettings.configured && captchaSettings.provider === 'hcaptcha') { %>
    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>
<% } %>

    <div class="max-w-xl mx-auto my-8 sm:my-12 px-4">
        <!-- Main Card Container -->
        <div
            class="bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200/80 overflow-hidden transition-all">

            <!-- Top Accent Bar -->
            <div class="h-1.5 bg-gradient-to-r from-indigo-500 via-indigo-600 to-indigo-800"></div>

            <div class="p-6 sm:p-10">
                <!-- Header Section -->
                <div class="text-center mb-8">
                    <div
                        class="w-12 h-12 bg-indigo-50 border border-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center mx-auto mb-3.5 shadow-sm">
                        <i class="ph-bold ph-user-plus text-2xl"></i>
                    </div>
                    <h2 class="text-2xl font-black text-slate-900 tracking-tight">Create an Account</h2>
                    <p class="text-xs text-slate-500 font-medium mt-1">Join InternPilot to explore or post opportunities
                    </p>
                </div>

                <% if (registrationMessage) { %>
                    <div class="mb-5 flex items-start gap-2 rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs font-medium text-rose-800" role="alert">
                        <i class="ph-bold ph-warning-circle mt-0.5 text-base"></i>
                        <span><%= registrationMessage %></span>
                    </div>
                <% } %>

                <!-- Registration Form -->
                <form action="/auth/register" method="POST" class="space-y-4" data-loading-text="Creating Account...">

                    <!-- Full Name Field -->
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Full
                            Name</label>
                        <div class="relative flex items-center">
                            <i class="ph-bold ph-user absolute left-3.5 text-slate-400 text-lg pointer-events-none"></i>
                            <input type="text" name="name" required placeholder="John Doe"
                                class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none transition-all duration-200">
                        </div>
                    </div>

                    <!-- Email Address Field -->
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Email
                            Address</label>
                        <div class="relative flex items-center">
                            <i
                                class="ph-bold ph-envelope-simple absolute left-3.5 text-slate-400 text-lg pointer-events-none"></i>
                            <input type="email" name="email" required placeholder="user@example.com"
                                class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none transition-all duration-200">
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div>
                        <label
                            class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Password</label>
                        <div class="relative flex items-center">
                            <i
                                class="ph-bold ph-lock-simple absolute left-3.5 text-slate-400 text-lg pointer-events-none"></i>
                            <input type="password" id="register-password" name="password" required
                                placeholder="••••••••"
                                class="w-full pl-10 pr-11 py-2.5 bg-slate-50/50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none transition-all duration-200">

                            <!-- Toggle Password Visibility Button -->
                            <button type="button" id="toggle-register-password"
                                class="absolute right-3.5 text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-md"
                                title="Toggle Password Visibility">
                                <i id="register-password-icon" class="ph-bold ph-eye text-lg"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Role Selector -->
                    <div>
                        <label
                            class="block text-xs font-semibold uppercase tracking-wider text-slate-600 mb-1.5">Registering
                            As</label>
                        <div class="relative flex items-center">
                            <i
                                class="ph-bold ph-user-gear absolute left-3.5 text-slate-400 text-lg pointer-events-none z-10"></i>
                            <select name="role" id="roleSelect" required onchange="handleRoleChange(this.value)"
                                class="w-full pl-10 pr-10 py-2.5 bg-slate-50/50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none transition-all duration-200 appearance-none cursor-pointer">
                                <option value="candidate" selected>Candidate (Looking for internships)</option>
                                <option value="company">Company (Posting internships)</option>
                                <option value="admin">Administrator (System Portal Admin)</option>
                            </select>
                            <i
                                class="ph-bold ph-caret-down absolute right-3.5 text-slate-400 text-sm pointer-events-none"></i>
                        </div>
                    </div>

                    <!-- Admin Security Key Field (Hidden by default) -->
                    <div id="adminSecretField"
                        class="hidden p-4 bg-amber-50/80 border border-amber-200 rounded-xl transition-all">
                        <div
                            class="flex items-center gap-2 mb-2 text-amber-800 font-semibold text-xs uppercase tracking-wider">
                            <i class="ph-bold ph-shield-warning text-base text-amber-600"></i>
                            <span>Admin Authorization Required</span>
                        </div>
                        <div class="relative flex items-center">
                            <i class="ph-bold ph-key absolute left-3.5 text-amber-500 text-lg pointer-events-none"></i>
                            <input type="password" name="adminSecretKey" placeholder="Enter system authorization code"
                                class="w-full pl-10 pr-4 py-2 bg-white border border-amber-300 rounded-lg text-slate-800 placeholder-slate-400 text-sm focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 outline-none transition-all">
                        </div>
                    </div>

                    <!-- Optional Company Fields (Hidden by default) -->
                    <div id="companyFields" class="hidden space-y-4 pt-3 border-t border-slate-200">
                        <div
                            class="flex items-center gap-2 text-indigo-900 font-semibold text-xs uppercase tracking-wider">
                            <i class="ph-bold ph-buildings text-indigo-600 text-base"></i>
                            <span>Company Verification Details</span>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Company Name</label>
                            <div class="relative flex items-center">
                                <i
                                    class="ph-bold ph-briefcase absolute left-3.5 text-slate-400 text-lg pointer-events-none"></i>
                                <input type="text" name="companyName" placeholder="Acme Corp"
                                    class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none transition-all">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">CIN Number</label>
                                <div class="relative flex items-center">
                                    <i
                                        class="ph-bold ph-identification-card absolute left-3.5 text-slate-400 text-lg pointer-events-none"></i>
                                    <input type="text" name="cin" placeholder="L12345MH2020PLC123456"
                                        class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none transition-all">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Industry</label>
                                <div class="relative flex items-center">
                                    <i
                                        class="ph-bold ph-factory absolute left-3.5 text-slate-400 text-lg pointer-events-none"></i>
                                    <input type="text" name="industry" placeholder="IT, Finance, etc."
                                        class="w-full pl-10 pr-4 py-2.5 bg-slate-50/50 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 text-sm focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-600 outline-none transition-all">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- hCaptcha creates the signed h-captcha-response field.
                         Server validation is mandatory before registration. -->
                    <% if (captchaSettings.configured && captchaSettings.provider === 'hcaptcha') { %>
                        <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
                            <p class="mb-2 text-xs font-semibold text-slate-700">Security check</p>
                            <div class="h-captcha" data-sitekey="<%= captchaSettings.siteKey %>"></div>
                            <noscript><p class="mt-2 text-xs text-rose-700">JavaScript is required to complete the security check.</p></noscript>
                        </div>
                    <% } else { %>
                        <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs font-medium text-rose-800" role="alert">
                            Registration is temporarily unavailable because the security check is not configured. Please try again later.
                        </div>
                    <% } %>

                    <!-- Submit Button -->
                    <button type="submit"
                        <% if (!captchaSettings.configured) { %>disabled aria-disabled="true"<% } %>
                        class="w-full bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 disabled:cursor-not-allowed disabled:from-slate-400 disabled:to-slate-500 text-white font-semibold py-2.5 px-4 rounded-xl shadow-md shadow-indigo-600/20 hover:shadow-indigo-600/30 active:scale-[0.99] transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer mt-2">
                        <span>Create Account</span>
                        <i class="ph-bold ph-arrow-right text-base"></i>
                    </button>
                </form>

                <!-- Divider -->
                <div class="relative flex py-6 items-center">
                    <div class="flex-grow border-t border-slate-200"></div>
                    <span class="flex-shrink mx-4 text-[11px] font-bold text-slate-400 uppercase tracking-wider">Or
                        continue with</span>
                    <div class="flex-grow border-t border-slate-200"></div>
                </div>

                <!-- Google OAuth Button -->
                <a href="/auth/google"
                    class="w-full flex items-center justify-center gap-3 bg-white border border-slate-300 hover:border-slate-400 hover:bg-slate-50/80 text-slate-700 font-semibold text-sm py-2.5 px-4 rounded-xl transition-all duration-200 shadow-sm active:scale-[0.99]">
                    <svg version="1.1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48">
                        <g>
                            <path fill="#EA4335"
                                d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z">
                            </path>
                            <path fill="#4285F4"
                                d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z">
                            </path>
                            <path fill="#FBBC05"
                                d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24s.92 7.54 2.56 10.78l7.97-6.19z">
                            </path>
                            <path fill="#34A853"
                                d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z">
                            </path>
                            <path fill="none" d="M0 0h48v48H0z"></path>
                        </g>
                    </svg>
                    <span>Sign up with Google</span>
                </a>

                <!-- Footer Login Link -->
                <p class="text-center text-xs text-slate-500 font-medium mt-8">
                    Already have an account?
                    <a href="/auth/login"
                        class="text-indigo-600 hover:text-indigo-700 hover:underline font-bold transition-colors">Log in
                        here</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Scripts for Conditional Role Rendering & Password Toggle -->
    <script>
        function handleRoleChange(role) {
            const companyFields = document.getElementById('companyFields');
            const adminSecretField = document.getElementById('adminSecretField');

            if (role === 'company') {
                companyFields.classList.remove('hidden');
                adminSecretField.classList.add('hidden');
            } else if (role === 'admin') {
                adminSecretField.classList.remove('hidden');
                companyFields.classList.add('hidden');
            } else {
                companyFields.classList.add('hidden');
                adminSecretField.classList.add('hidden');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Password Visibility Toggle
            const passwordInput = document.getElementById('register-password');
            const toggleBtn = document.getElementById('toggle-register-password');
            const toggleIcon = document.getElementById('register-password-icon');

            if (toggleBtn && passwordInput && toggleIcon) {
                toggleBtn.addEventListener('click', () => {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                    if (isPassword) {
                        toggleIcon.className = 'ph-bold ph-eye-slash text-indigo-600';
                    } else {
                        toggleIcon.className = 'ph-bold ph-eye text-lg';
                    }
                });
            }
        });
    </script>
