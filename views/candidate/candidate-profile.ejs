<% layout('layouts/boilerplate') %>

    <% const activeUser=(typeof candidate !=='undefined' && candidate) ? candidate : ((typeof user !=='undefined' &&
        user) ? user : currentUser); %>
    <% const profileSkillEntries = (typeof skillProfiles !== 'undefined' && Array.isArray(skillProfiles) && skillProfiles.length)
        ? skillProfiles
        : ((activeUser && Array.isArray(activeUser.skills))
            ? activeUser.skills.map(name => ({ name, proficiency: 'Intermediate' }))
            : []); %>

    <% 
    let resumeDisplayName = '';
    if (activeUser && activeUser.resumeOriginalName) {
        resumeDisplayName = activeUser.resumeOriginalName;
    } else if (activeUser && (activeUser.resume || activeUser.resumeUrl)) {
        const rUrl = activeUser.resume || activeUser.resumeUrl;
        try {
            const parts = rUrl.split('/');
            const lastPart = parts[parts.length - 1].split('?')[0];
            resumeDisplayName = decodeURIComponent(lastPart.replace(/^\d+_/, '')) || 'resume.pdf';
        } catch (_) {
            resumeDisplayName = 'resume.pdf';
        }
    }
    const hasResume = Boolean(activeUser && (activeUser.resume || activeUser.resumeUrl));
    const savedResumeVersions = activeUser && Array.isArray(activeUser.resumeVersions)
        ? activeUser.resumeVersions
        : [];
    %>

    <% const pmisStatus = (typeof eligibility !== 'undefined' && eligibility) 
        ? eligibility 
        : ((typeof checkPmisEligibility === 'function' && activeUser) 
            ? checkPmisEligibility(activeUser) 
            : {
                status: 'incomplete',
                badge: { label: 'Incomplete — More Info Needed', bgClass: 'bg-amber-50 text-amber-800 border-amber-200', icon: 'ph-warning-circle' },
                reasons: [],
                missingFields: ['Age', 'Family Income', 'Qualification', 'Enrollment Status', 'Employment Status'],
                criteria: []
            }); %>

        <div class="max-w-7xl mx-auto space-y-6">

            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl text-xs font-semibold flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-2">
                        <i class="ph-bold ph-check-circle text-emerald-600 text-base"></i>
                        <span><%= success_msg %></span>
                    </div>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs font-semibold flex items-center justify-between shadow-sm">
                    <div class="flex items-center gap-2">
                        <i class="ph-bold ph-warning-circle text-rose-600 text-base"></i>
                        <span><%= error_msg %></span>
                    </div>
                </div>
            <% } %>

            <div
                class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-5">
                    <div
                        class="w-20 h-20 bg-indigo-100 text-indigo-700 font-extrabold text-3xl rounded-full flex items-center justify-center border-2 border-indigo-200 shrink-0">
                        <%= (activeUser && activeUser.name) ? activeUser.name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2.5">
                            <h1 class="text-2xl font-bold text-slate-800 tracking-tight">
                                <%= activeUser ? activeUser.name : '' %>
                            </h1>
                            <span id="headerEligibilityBadge"
                                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border <%= pmisStatus.badge.bgClass %> shadow-xs">
                                <i class="ph-bold <%= pmisStatus.badge.icon %>"></i>
                                <%= pmisStatus.badge.label %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium flex items-center gap-1 mt-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-500" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <%= (activeUser && activeUser.location) ? (typeof activeUser.location==='object' ?
                                ([activeUser.location.district, activeUser.location.state].filter(Boolean).join(', ') || 'Location Not Provided') : activeUser.location)
                                : 'Location Not Provided' %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <a href="/candidate/saved-internships" class="inline-flex items-center gap-2 bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs px-4 py-2.5 rounded-lg border border-rose-200 transition-colors cursor-pointer">
                        <i class="ph-fill ph-bookmark-simple text-base"></i>
                        Saved Internships
                    </a>
                    <button id="openModalBtn" type="button"
                        class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-4 py-2.5 rounded-lg border border-slate-200 transition-colors cursor-pointer">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-600" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                        </svg>
                        Edit Profile
                    </button>

                    <a href="/candidate/resume-builder"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-lg text-xs">
                        Resume Builder
                    </a>
                    <a href="/internships"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-4 py-2.5 rounded-lg transition-colors shadow-sm">
                        Browse Internships
                    </a>
                </div>
            </div>

            <!-- Dedicated PMIS Eligibility Status Card -->
            <div id="pmisEligibilityCard"
                class="bg-white border <%= pmisStatus.status === 'eligible' ? 'border-emerald-200' : (pmisStatus.status === 'ineligible' ? 'border-rose-200' : 'border-amber-200') %> rounded-2xl p-6 shadow-sm space-y-5 transition-all">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-xl <%= pmisStatus.status === 'eligible' ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : (pmisStatus.status === 'ineligible' ? 'bg-rose-50 text-rose-600 border-rose-100' : 'bg-amber-50 text-amber-600 border-amber-100') %> flex items-center justify-center text-xl shrink-0 font-bold border">
                            <i class="ph-bold <%= pmisStatus.badge.icon %>"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-base font-bold text-slate-800">PMIS Eligibility Status</h2>
                                <a href="/guidelines" target="_blank"
                                    class="text-xs text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-1"
                                    title="View official PMIS guidelines">
                                    <i class="ph-bold ph-info"></i> Guidelines
                                </a>
                            </div>
                            <p class="text-xs text-slate-500">Evaluated against the Prime Minister's Internship Scheme rules</p>
                        </div>
                    </div>
                    <div class="shrink-0">
                        <span id="cardEligibilityBadge"
                            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold border <%= pmisStatus.badge.bgClass %> shadow-xs">
                            <i class="ph-bold <%= pmisStatus.badge.icon %> text-sm"></i>
                            <span><%= pmisStatus.badge.label %></span>
                        </span>
                    </div>
                </div>

                <!-- Status Feedback Callouts -->
                <% if (pmisStatus.status === 'eligible') { %>
                    <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-4 flex items-start gap-3 text-xs text-emerald-800">
                        <i class="ph-fill ph-check-circle text-emerald-600 text-lg shrink-0 mt-0.5"></i>
                        <div class="space-y-1">
                            <p class="font-bold text-emerald-900">You meet all eligibility criteria under the Prime Minister's Internship Scheme!</p>
                            <p class="text-emerald-700">You are eligible to apply for scheme internships and receive the monthly stipend (₹5,000) and one-time incident grant (₹6,000).</p>
                        </div>
                    </div>
                <% } else if (pmisStatus.status === 'ineligible') { %>
                    <div class="bg-rose-50/80 border border-rose-200 rounded-xl p-4 space-y-2.5 text-xs text-rose-800">
                        <div class="flex items-center gap-2 font-bold text-rose-900 text-sm">
                            <i class="ph-bold ph-x-circle text-rose-600 text-base shrink-0"></i>
                            <span>Disqualifying Criteria Identified:</span>
                        </div>
                        <ul class="space-y-1.5 pl-6 list-disc text-rose-700 font-medium">
                            <% pmisStatus.reasons.forEach(reason => { %>
                                <li><%= reason %></li>
                            <% }) %>
                        </ul>
                        <% if (pmisStatus.missingFields && pmisStatus.missingFields.length > 0) { %>
                            <div class="pt-2 border-t border-rose-200/60 text-rose-600">
                                <span class="font-semibold">Additionally missing:</span> <%= pmisStatus.missingFields.join('; ') %>
                            </div>
                        <% } %>
                        <p class="text-[11px] text-rose-600 pt-1">
                            If any information on your profile was entered incorrectly, you can update it by clicking <button type="button" onclick="document.getElementById('openModalBtn').click()" class="underline font-bold hover:text-rose-800 cursor-pointer">Edit Profile</button>.
                        </p>
                    </div>
                <% } else { %>
                    <div class="bg-amber-50/80 border border-amber-200 rounded-xl p-4 space-y-2.5 text-xs text-amber-800">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="flex items-center gap-2 font-bold text-amber-900 text-sm">
                                <i class="ph-bold ph-warning-circle text-amber-600 text-base shrink-0"></i>
                                <span>Profile Incomplete — More Information Needed</span>
                            </div>
                            <button type="button" onclick="document.getElementById('openModalBtn').click()"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-lg transition-colors cursor-pointer shadow-xs shrink-0">
                                <i class="ph-bold ph-pencil-simple"></i> Complete Profile
                            </button>
                        </div>
                        <p class="text-amber-700">Please provide the following required details on your profile to verify your PMIS scheme eligibility:</p>
                        <ul class="space-y-1.5 pl-6 list-disc text-amber-900 font-medium">
                            <% pmisStatus.missingFields.forEach(field => { %>
                                <li><%= field %></li>
                            <% }) %>
                        </ul>
                    </div>
                <% } %>

                <!-- Criteria Checklist Breakdown -->
                <% if (pmisStatus.criteria && pmisStatus.criteria.length > 0) { %>
                    <div>
                        <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3">Eligibility Criteria Breakdown</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                            <% pmisStatus.criteria.forEach(item => { %>
                                <div class="border rounded-xl p-3 flex flex-col justify-between text-xs space-y-2 <%= item.status === 'pass' ? 'border-emerald-100 bg-emerald-50/30' : (item.status === 'fail' ? 'border-rose-100 bg-rose-50/30' : 'border-amber-100 bg-amber-50/30') %>">
                                    <div class="flex items-start justify-between gap-2">
                                        <span class="font-bold text-slate-800"><%= item.label %></span>
                                        <% if (item.status === 'pass') { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full shrink-0">
                                                <i class="ph-bold ph-check"></i> Eligible
                                            </span>
                                        <% } else if (item.status === 'fail') { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-700 bg-rose-100 px-2 py-0.5 rounded-full shrink-0">
                                                <i class="ph-bold ph-x"></i> Disqualified
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-full shrink-0">
                                                <i class="ph-bold ph-warning"></i> Missing
                                            </span>
                                        <% } %>
                                    </div>
                                    <div class="text-[11px] text-slate-600">
                                        <span class="text-slate-400 block text-[10px] uppercase font-semibold">Your Profile</span>
                                        <span class="font-semibold text-slate-700"><%= item.value %></span>
                                    </div>
                                    <p class="text-[11px] <%= item.status === 'pass' ? 'text-emerald-700' : (item.status === 'fail' ? 'text-rose-700' : 'text-amber-700') %>">
                                        <%= item.message %>
                                    </p>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">


                <div class="lg:col-span-2 space-y-6">


                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Candidate Details
                        </h2>

                        <div class="grid grid-cols-2 gap-4 text-xs">
                            <div>
                                <span class="text-slate-400 font-medium block">Age</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.age) ? activeUser.age + ' years' : 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Annual Family Income</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.familyIncome !== undefined && activeUser.familyIncome !== null && activeUser.familyIncome !== '') ? '₹' +
                                        Number(activeUser.familyIncome).toLocaleString('en-IN') + ' / year'
                                        : 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Qualification</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.education && activeUser.education.qualification) ?
                                        activeUser.education.qualification : ((activeUser && activeUser.qualification) ?
                                        activeUser.qualification : 'Not Specified' ) %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Institution</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <%= (activeUser && activeUser.institution) ? activeUser.institution : 'Not Specified' %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Formal Education Status</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <% const enroll = (activeUser && activeUser.enrollmentStatus) ? activeUser.enrollmentStatus : ''; %>
                                    <%= enroll === 'not_enrolled' ? 'Not Enrolled / Completed' : (enroll === 'part_time_or_distance' ? 'Part-time / Distance' : (enroll === 'full_time' ? 'Full-time Student' : 'Not Specified')) %>
                                </span>
                            </div>
                            <div>
                                <span class="text-slate-400 font-medium block">Employment Status</span>
                                <span class="font-bold text-slate-700 text-sm">
                                    <% const emp = (activeUser && activeUser.employmentStatus) ? activeUser.employmentStatus : ''; %>
                                    <%= emp === 'unemployed' ? 'Unemployed / Seeking Internship' : (emp === 'part_time_or_freelance' ? 'Part-time / Freelance' : (emp === 'full_time' ? 'Full-time Employed' : 'Not Specified')) %>
                                </span>
                            </div>
                            <div class="col-span-2 pt-2.5 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <div>
                                    <span class="text-slate-400 font-medium block">Resume on File</span>
                                    <% if (hasResume) { %>
                                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 mt-0.5">
                                            <i class="ph-bold ph-check-circle text-emerald-600 text-sm"></i>
                                            Resume uploaded: <span class="text-slate-800 font-semibold"><%= resumeDisplayName %></span>
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 mt-0.5">
                                            <i class="ph-bold ph-warning-circle text-amber-600 text-sm"></i>
                                            No resume currently on file
                                        </span>
                                    <% } %>
                                </div>
                                <div class="flex items-center gap-2">
                                    <% if (hasResume) { %>
                                        <a href="<%= activeUser.resume || activeUser.resumeUrl %>" target="_blank"
                                           class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition-colors">
                                            <i class="ph-bold ph-arrow-square-out"></i> View
                                        </a>
                                        <button type="button" onclick="window.showResumeReplace && window.showResumeReplace()"
                                                class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors cursor-pointer">
                                            <i class="ph-bold ph-arrows-clockwise"></i> Replace
                                        </button>
                                    <% } else { %>
                                        <button type="button" onclick="window.showResumeReplace && window.showResumeReplace()"
                                                class="inline-flex items-center gap-1 text-xs font-bold px-3 py-1 rounded bg-indigo-600 hover:bg-indigo-700 text-white transition-colors cursor-pointer">
                                            <i class="ph-bold ph-upload-simple"></i> Upload Resume
                                        </button>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div
                            class="rounded-xl p-3 text-xs flex items-center justify-between gap-3 <%= pmisStatus.status === 'eligible' ? 'bg-emerald-50 border border-emerald-200 text-emerald-800' : (pmisStatus.status === 'ineligible' ? 'bg-rose-50 border border-rose-200 text-rose-800' : 'bg-amber-50 border border-amber-200 text-amber-800') %>">
                            <div class="flex items-center gap-2">
                                <i class="ph-bold <%= pmisStatus.badge.icon %> text-base shrink-0"></i>
                                <span>
                                    <strong>PMIS Evaluation:</strong> <%= pmisStatus.badge.label %>
                                    <% if (pmisStatus.status !== 'eligible') { %>
                                        — <%= (pmisStatus.reasons[0] || pmisStatus.missingFields[0] || 'See criteria card for details.') %>
                                    <% } %>
                                </span>
                            </div>
                            <a href="#pmisEligibilityCard"
                                class="underline font-bold shrink-0 hover:opacity-80">
                                Details
                            </a>
                        </div>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <h2
                            class="text-sm font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            Technical & Soft Skills
                        </h2>

                        <% if (profileSkillEntries.length > 0) { %>
                                <div class="flex flex-wrap gap-2">
                                    <% profileSkillEntries.forEach(skill => { %>
                                        <span
                                            class="inline-flex items-center gap-1.5 bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm">
                                            <%= skill.name %>
                                            <span class="rounded bg-white/80 px-1.5 py-0.5 text-[10px] font-bold text-indigo-800" aria-label="<%= skill.name %> proficiency: <%= skill.proficiency %>">
                                                <%= skill.proficiency %>
                                            </span>
                                        </span>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 italic">No skills added yet.</p>
                                    <% } %>
                    </div>

                    <% const certifications = (activeUser && activeUser.certifications) ? activeUser.certifications : []; %>
                        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                    <i class="ph-bold ph-certificate text-indigo-600 text-lg"></i>
                                    Certifications
                                </h2>
                                <button type="button" data-cert-add
                                    class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm cursor-pointer">
                                    <i class="ph-bold ph-plus"></i> Add
                                </button>
                            </div>

                            <% if (certifications.length> 0) { %>
                                <div class="space-y-3">
                                    <% certifications.forEach(cert=> { %>
                                        <div class="border border-slate-100 rounded-lg p-3 flex items-start justify-between gap-3">
                                            <div class="min-w-0">
                                                <h4 class="text-sm font-bold text-slate-800 truncate">
                                                    <%= cert.name %>
                                                </h4>
                                                <% if (cert.issuer) { %>
                                                    <p class="text-xs text-slate-500 mt-0.5">Issued by <%= cert.issuer %>
                                                    </p>
                                                    <% } %>
                                                        <% if (cert.issueDate) { %>
                                                            <p class="text-xs text-slate-400 mt-0.5">
                                                                <%= new Date(cert.issueDate).toLocaleDateString('en-IN', {
                                                                    month: 'short' , year: 'numeric' }) %>
                                                            </p>
                                                            <% } %>
                                                                <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                                                    <% if (cert.link) { %>
                                                                        <a href="<%= cert.link %>" target="_blank"
                                                                            rel="noopener noreferrer"
                                                                            class="text-xs text-indigo-600 hover:underline font-semibold">Credential
                                                                            Link</a>
                                                                        <% } %>
                                                                            <% if (cert.fileUrl) { %>
                                                                                <a href="<%= cert.fileUrl %>" target="_blank"
                                                                                    rel="noopener noreferrer"
                                                                                    class="text-xs text-emerald-700 hover:underline font-semibold">
                                                                                    <%= cert.fileName || 'View Certificate' %>
                                                                                </a>
                                                                                <% } %>
                                                                </div>
                                            </div>

                                            <div class="flex items-center gap-1 shrink-0">
                                                <button type="button" class="text-slate-400 hover:text-indigo-600 p-1"
                                                    title="Edit certification" data-cert-edit
                                                    data-id="<%= cert._id %>"
                                                    data-name="<%= cert.name %>"
                                                    data-issuer="<%= cert.issuer || '' %>"
                                                    data-link="<%= cert.link || '' %>"
                                                    data-issuedate="<%= cert.issueDate ? new Date(cert.issueDate).toISOString().slice(0, 10) : '' %>">
                                                    <i class="ph-bold ph-pencil-simple"></i>
                                                </button>
                                                <form action="/candidate/profile/certifications/<%= cert._id %>?_method=DELETE"
                                                    method="POST"
                                                    onsubmit="return confirm('Remove this certification?');">
                                                    <button type="submit" class="text-slate-400 hover:text-rose-600 p-1"
                                                        title="Delete certification">
                                                        <i class="ph-bold ph-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } else { %>
                                    <p class="text-xs text-slate-400 italic">No certifications added yet.</p>
                                    <% } %>
                        </div>

                        <% const projects = (activeUser && activeUser.projects) ? activeUser.projects : []; %>
                            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                                    <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                        <i class="ph-bold ph-code text-indigo-600 text-lg"></i>
                                        Projects
                                    </h2>
                                    <button type="button" data-project-add
                                        class="inline-flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors shadow-sm cursor-pointer">
                                        <i class="ph-bold ph-plus"></i> Add
                                    </button>
                                </div>

                                <% if (projects.length> 0) { %>
                                    <div class="space-y-3">
                                        <% projects.forEach(project=> { %>
                                            <div
                                                class="border border-slate-100 rounded-lg p-3 flex items-start justify-between gap-3">
                                                <div class="min-w-0">
                                                    <h4 class="text-sm font-bold text-slate-800 truncate">
                                                        <%= project.title %>
                                                    </h4>
                                                    <% if (project.description) { %>
                                                        <p class="text-xs text-slate-500 mt-1">
                                                            <%= project.description %>
                                                        </p>
                                                        <% } %>
                                                            <% if (project.techStack && project.techStack.length> 0) { %>
                                                                <div class="flex flex-wrap gap-1.5 mt-2">
                                                                    <% project.techStack.forEach(tech=> { %>
                                                                        <span
                                                                            class="bg-slate-100 border border-slate-200 text-slate-600 text-[11px] font-semibold px-2 py-0.5 rounded">
                                                                            <%= tech %>
                                                                        </span>
                                                                        <% }) %>
                                                                </div>
                                                                <% } %>
                                                                    <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                                                        <% if (project.link) { %>
                                                                            <a href="<%= project.link %>" target="_blank"
                                                                                rel="noopener noreferrer"
                                                                                class="text-xs text-indigo-600 hover:underline font-semibold">View
                                                                                Project</a>
                                                                            <% } %>
                                                                                <% if (project.fileUrl) { %>
                                                                                    <a href="<%= project.fileUrl %>"
                                                                                        target="_blank"
                                                                                        rel="noopener noreferrer"
                                                                                        class="text-xs text-emerald-700 hover:underline font-semibold">
                                                                                        <%= project.fileName || 'View Attachment' %>
                                                                                    </a>
                                                                                    <% } %>
                                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-1 shrink-0">
                                                    <button type="button" class="text-slate-400 hover:text-indigo-600 p-1"
                                                        title="Edit project" data-project-edit
                                                        data-id="<%= project._id %>"
                                                        data-title="<%= project.title %>"
                                                        data-description="<%= project.description || '' %>"
                                                        data-link="<%= project.link || '' %>"
                                                        data-techstack="<%= (project.techStack || []).join(', ') %>">
                                                        <i class="ph-bold ph-pencil-simple"></i>
                                                    </button>
                                                    <form action="/candidate/profile/projects/<%= project._id %>?_method=DELETE"
                                                        method="POST"
                                                        onsubmit="return confirm('Remove this project?');">
                                                        <button type="submit" class="text-slate-400 hover:text-rose-600 p-1"
                                                            title="Delete project">
                                                            <i class="ph-bold ph-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <p class="text-xs text-slate-400 italic">No projects added yet.</p>
                                        <% } %>
                            </div>

                </div>

                <div class="space-y-6">
                    <div id="resumeUploadCard" class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                                <i class="ph-bold ph-file-text text-indigo-600 text-lg"></i>
                                Resume Status & Parser
                            </h2>
                            <span id="resumeStatusBadge"
                                class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold border <%= hasResume ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-amber-50 text-amber-800 border-amber-200' %>">
                                <i class="ph-bold <%= hasResume ? 'ph-check-circle text-emerald-600' : 'ph-warning-circle text-amber-600' %>"></i>
                                <%= hasResume ? 'On File' : 'Not Uploaded' %>
                            </span>
                        </div>

                        <!-- Persistent Resume Info or Empty Warning -->
                        <% if (hasResume) { %>
                            <div class="bg-indigo-50/40 border border-indigo-100 rounded-xl p-4 space-y-3">
                                <div class="flex items-start gap-3">
                                    <div class="w-10 h-10 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xl shrink-0">
                                        <i class="ph-bold ph-file-pdf"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <p class="text-xs font-bold text-slate-900 truncate" title="<%= resumeDisplayName %>">
                                                Resume uploaded: <span class="text-indigo-900 font-semibold"><%= resumeDisplayName %></span>
                                            </p>
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                                Active
                                            </span>
                                        </div>
                                        <p class="text-[11px] text-slate-500 mt-0.5">
                                            <% if (activeUser && activeUser.resumeUploadedAt) { %>
                                                Uploaded on <%= new Date(activeUser.resumeUploadedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                            <% } else { %>
                                                Active resume on file — visible to recruiters
                                            <% } %>
                                        </p>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2 pt-2 border-t border-indigo-100/70">
                                    <a href="<%= activeUser.resume || activeUser.resumeUrl %>" target="_blank"
                                       class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white transition-colors shadow-xs">
                                        <i class="ph-bold ph-arrow-square-out"></i>
                                        View Resume
                                    </a>
                                    <button type="button" id="toggleReplaceResumeBtn"
                                            class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 transition-colors cursor-pointer">
                                        <i class="ph-bold ph-arrows-clockwise"></i>
                                        Replace Resume
                                    </button>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="bg-amber-50/70 border border-amber-200 rounded-xl p-3.5 flex items-start gap-3 text-xs text-amber-800">
                                <i class="ph-bold ph-warning-circle text-amber-600 text-lg shrink-0 mt-0.5"></i>
                                <div class="space-y-1">
                                    <p class="font-bold text-amber-900">No resume currently on file</p>
                                    <p class="text-amber-700">Recruiters rely on your resume to evaluate applications. Upload your resume so employers can review your qualifications.</p>
                                </div>
                            </div>
                        <% } %>

                        <% if (savedResumeVersions.length) { %>
                            <section class="border-t border-slate-100 pt-4" aria-label="Saved resume versions">
                                <div class="flex items-center justify-between gap-3">
                                    <div>
                                        <h3 class="text-xs font-bold text-slate-800">Saved resume versions</h3>
                                        <p class="mt-0.5 text-[11px] text-slate-500">Select a default for new applications. Submitted kits keep their original file.</p>
                                    </div>
                                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600"><%= savedResumeVersions.length %></span>
                                </div>
                                <div class="mt-3 space-y-2">
                                    <% savedResumeVersions.slice().reverse().forEach(version => { %>
                                        <div class="flex flex-col gap-2 rounded-xl border border-slate-200 bg-slate-50/70 p-3 sm:flex-row sm:items-center sm:justify-between">
                                            <div class="min-w-0">
                                                <p class="truncate text-xs font-bold text-slate-800"><%= version.label || version.fileName || 'Resume version' %></p>
                                                <p class="mt-0.5 truncate text-[11px] text-slate-500"><%= version.fileName || 'Resume file' %><% if (version.createdAt) { %> · <%= new Date(version.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %><% } %></p>
                                            </div>
                                            <div class="flex flex-wrap items-center gap-2">
                                                <% if (version.fileUrl) { %><a href="<%= version.fileUrl %>" target="_blank" rel="noopener noreferrer" class="text-[11px] font-semibold text-indigo-700 hover:underline">View</a><% } %>
                                                <% if (version.isDefault) { %>
                                                    <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-1 text-[10px] font-bold text-emerald-700">Default</span>
                                                <% } else { %>
                                                    <form action="/candidate/profile/resume-versions/<%= version._id %>/default" method="POST"><button type="submit" class="rounded-lg border border-indigo-200 bg-white px-2 py-1 text-[10px] font-bold text-indigo-700 hover:bg-indigo-50">Make default</button></form>
                                                <% } %>
                                                <form action="/candidate/profile/resume-versions/<%= version._id %>/delete" method="POST" onsubmit="return confirm('Remove this saved resume version?');"><button type="submit" class="rounded-lg border border-rose-200 bg-white px-2 py-1 text-[10px] font-bold text-rose-700 hover:bg-rose-50">Remove</button></form>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </section>
                        <% } %>

                        <!-- Upload / Replace Resume Form -->
                        <div id="resumeFormWrapper" class="<%= hasResume ? 'hidden' : '' %> space-y-3 pt-1">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xs font-bold text-slate-700">
                                    <%= hasResume ? 'Replace Uploaded Resume' : 'Upload New Resume' %>
                                </h3>
                                <% if (hasResume) { %>
                                    <button type="button" id="cancelReplaceBtn" class="text-[11px] text-slate-500 hover:text-slate-800 font-semibold cursor-pointer">
                                        Cancel
                                    </button>
                                <% } %>
                            </div>

                            <form id="resumeUploadForm" action="/candidate/parse-resume" method="POST" enctype="multipart/form-data"
                                class="space-y-3" data-loading-text="<%= hasResume ? 'Replacing & Parsing Resume...' : 'Uploading & Parsing Resume...' %>">
                                <div>
                                    <label for="resumeLabel" class="mb-1 block text-xs font-semibold text-slate-700">Resume version label <span class="font-normal text-slate-400">(optional)</span></label>
                                    <input id="resumeLabel" type="text" name="resumeLabel" maxlength="100" placeholder="e.g. Software engineering resume" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-xs text-slate-800 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100">
                                    <p class="mt-1 text-[11px] text-slate-500">This helps you choose the right version in an Application Kit.</p>
                                </div>
                                
                                <div id="resumeDropzone"
                                    class="border-2 border-dashed border-indigo-200 hover:border-indigo-400 rounded-xl p-5 text-center bg-indigo-50/40 hover:bg-indigo-50 transition-all cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-indigo-500 mx-auto mb-2 pointer-events-none"
                                        fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                                    </svg>
                                    <p class="text-xs font-bold text-indigo-700 mb-0.5 pointer-events-none">
                                        <%= hasResume ? 'Choose replacement file or drag & drop' : 'Choose resume or drag & drop' %>
                                    </p>
                                    <p class="text-[11px] text-slate-500 pointer-events-none">
                                        Supports PDF or Word documents (.pdf, .docx, .doc) up to 5MB
                                    </p>
                                    <input id="resumeInput" type="file" name="resume" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="hidden">
                                </div>

                                <!-- File selection preview -->
                                <div id="fileSelectionPreview" class="hidden bg-slate-50 border border-slate-200 rounded-xl p-3 items-center justify-between gap-3 text-xs">
                                    <div class="flex items-center gap-2.5 min-w-0">
                                        <div class="w-8 h-8 rounded bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                                            <i id="previewFileIcon" class="ph-bold ph-file-pdf text-base"></i>
                                        </div>
                                        <div class="min-w-0">
                                            <p id="previewFileName" class="font-bold text-slate-800 truncate"></p>
                                            <p id="previewFileSize" class="text-[11px] text-slate-500"></p>
                                        </div>
                                    </div>
                                    <button type="button" id="clearFileBtn" class="text-slate-400 hover:text-rose-600 p-1 rounded-md transition-colors" title="Remove selected file">
                                        <i class="ph-bold ph-x text-sm"></i>
                                    </button>
                                </div>

                                <!-- Client inline error alert -->
                                <div id="resumeClientError" class="hidden bg-rose-50 border border-rose-200 text-rose-700 px-3.5 py-2.5 rounded-xl text-xs flex items-start gap-2 shadow-xs">
                                    <i class="ph-bold ph-warning-circle text-rose-600 text-base shrink-0 mt-0.5"></i>
                                    <span id="resumeClientErrorText" class="font-medium"></span>
                                </div>

                                <button type="submit" id="resumeSubmitBtn"
                                    class="w-full bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs py-2.5 rounded-lg transition-colors shadow-sm flex items-center justify-center gap-2 cursor-pointer">
                                    <i class="ph-bold ph-upload-simple"></i>
                                    <span><%= hasResume ? 'Upload & Replace Resume' : 'Upload & Extract Details' %></span>
                                </button>
                            </form>
                        </div>

                        <% if (typeof resumeParse !== 'undefined' && resumeParse) { %><%- include('../partials/resume-parse-summary', { parse: resumeParse, profile: activeUser }) %><% } %>

                        <!-- Resume Quality Analysis -->
                        <% if (activeUser && activeUser.resumeQuality) { %>
                            <div class="bg-emerald-50/70 border border-emerald-100 rounded-xl p-4 space-y-3">
                                <div class="flex items-center justify-between border-b border-emerald-100 pb-2">
                                    <h3 class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                                        <i class="ph-bold ph-sparkle text-emerald-600"></i>
                                        Resume Quality Feedback
                                    </h3>
                                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">AI Analyzed</span>
                                </div>

                                <% if (activeUser.resumeQuality.quantifiableAchievements && activeUser.resumeQuality.quantifiableAchievements.feedback) { %>
                                <div>
                                    <p class="text-[11px] font-bold text-slate-700">Quantifiable Achievements</p>
                                    <p class="text-xs text-slate-600 leading-relaxed"><%= activeUser.resumeQuality.quantifiableAchievements.feedback %></p>
                                </div>
                                <% } %>

                                <% if (activeUser.resumeQuality.technicalSkills && activeUser.resumeQuality.technicalSkills.feedback) { %>
                                <div>
                                    <p class="text-[11px] font-bold text-slate-700">Technical Skills</p>
                                    <p class="text-xs text-slate-600 leading-relaxed"><%= activeUser.resumeQuality.technicalSkills.feedback %></p>
                                </div>
                                <% } %>

                                <% if (activeUser.resumeQuality.projects && activeUser.resumeQuality.projects.feedback) { %>
                                <div>
                                    <p class="text-[11px] font-bold text-slate-700">Projects</p>
                                    <p class="text-xs text-slate-600 leading-relaxed"><%= activeUser.resumeQuality.projects.feedback %></p>
                                </div>
                                <% } %>

                                <% if (activeUser.resumeQuality.overallFeedback) { %>
                                <div>
                                    <p class="text-[11px] font-bold text-slate-700">Overall Feedback</p>
                                    <p class="text-xs text-slate-600 leading-relaxed"><%= activeUser.resumeQuality.overallFeedback %></p>
                                </div>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>

        </div>

        <% if (typeof showConflictModal !== 'undefined' && showConflictModal && typeof conflicts !== 'undefined' && conflicts.length > 0) { %>
            <%- include('../partials/profileConflictModal') %>
        <% } %>

        <div id="editProfileModal"
            class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white border border-slate-200 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 class="text-base font-bold text-slate-900">Update Profile Details</h3>
                    <button id="closeModalBtn" type="button"
                        class="text-slate-400 hover:text-slate-600 p-1 text-lg font-bold">
                        ✕
                    </button>
                </div>

                <form id="editProfileForm" action="/candidate/profile/edit" method="POST" class="mt-4 space-y-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Location (District, State)</label>
                        <input type="text" name="location"
                            value="<%= (activeUser && activeUser.location) ? (typeof activeUser.location === 'object' ? [activeUser.location.district, activeUser.location.state].filter(Boolean).join(', ') : activeUser.location) : '' %>"
                            placeholder="e.g. Noida, Uttar Pradesh"
                            class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">Age</label>
                            <input type="number" name="age" id="editAge"
                                value="<%= (activeUser && activeUser.age && activeUser.age > 0) ? activeUser.age : '' %>" placeholder="21-24"
                                min="15" max="60"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">Family Income (₹/year)</label>
                            <input type="number" name="familyIncome" id="editFamilyIncome"
                                value="<%= (activeUser && activeUser.familyIncome !== undefined && activeUser.familyIncome !== null && activeUser.familyIncome !== '') ? activeUser.familyIncome : '' %>"
                                placeholder="e.g. 350000"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                        </div>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Highest Qualification</label>
                        <input type="text" name="qualification" id="editQualification"
                            value="<%= (activeUser && activeUser.education && activeUser.education.qualification) ? activeUser.education.qualification : ((activeUser && activeUser.qualification) ? activeUser.qualification : '') %>"
                            placeholder="e.g. B.Tech / B.Sc"
                            class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Institution Name</label>
                        <input type="text" name="institution"
                            value="<%= (activeUser && activeUser.institution) ? activeUser.institution : '' %>"
                            placeholder="e.g. Delhi University"
                            class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">Formal Education Enrollment</label>
                            <select name="enrollmentStatus" id="editEnrollmentStatus"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none bg-white">
                                <option value="">Select Enrollment...</option>
                                <option value="not_enrolled" <%= (activeUser && activeUser.enrollmentStatus === 'not_enrolled') ? 'selected' : '' %>>Not Enrolled / Completed</option>
                                <option value="part_time_or_distance" <%= (activeUser && activeUser.enrollmentStatus === 'part_time_or_distance') ? 'selected' : '' %>>Part-time / Distance Learning</option>
                                <option value="full_time" <%= (activeUser && activeUser.enrollmentStatus === 'full_time') ? 'selected' : '' %>>Full-time Formal Education (Ineligible)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-700 mb-1">Employment Status</label>
                            <select name="employmentStatus" id="editEmploymentStatus"
                                class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none bg-white">
                                <option value="">Select Employment...</option>
                                <option value="unemployed" <%= (activeUser && activeUser.employmentStatus === 'unemployed') ? 'selected' : '' %>>Unemployed / Seeking Internship</option>
                                <option value="part_time_or_freelance" <%= (activeUser && activeUser.employmentStatus === 'part_time_or_freelance') ? 'selected' : '' %>>Part-time / Freelance</option>
                                <option value="full_time" <%= (activeUser && activeUser.employmentStatus === 'full_time') ? 'selected' : '' %>>Full-time Regular Employment (Ineligible)</option>
                            </select>
                        </div>
                    </div>
                    <div>
                        <div class="flex items-center justify-between gap-3 mb-1">
                            <label class="block font-semibold text-slate-700">Skills and proficiency</label>
                            <button type="button" id="addSkillProfileBtn"
                                class="text-indigo-700 hover:text-indigo-800 font-bold inline-flex items-center gap-1">
                                <i class="ph-bold ph-plus"></i> Add skill
                            </button>
                        </div>
                        <p class="text-[11px] text-slate-500 mb-2">Choose the level that best reflects your current ability.</p>
                        <div id="skillProfileFields" class="space-y-2">
                            <% const editableSkillEntries = profileSkillEntries.length ? profileSkillEntries : [{ name: '', proficiency: 'Intermediate' }]; %>
                            <% editableSkillEntries.forEach(skill => { %>
                                <div data-skill-profile-row class="grid grid-cols-[minmax(0,1fr)_auto_auto] gap-2 items-center">
                                    <label class="sr-only">Skill name</label>
                                    <input type="text" name="skillName" value="<%= skill.name %>" maxlength="80"
                                        placeholder="e.g. JavaScript"
                                        class="min-w-0 px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none">
                                    <label class="sr-only">Proficiency</label>
                                    <select name="skillProficiency" aria-label="Proficiency for <%= skill.name || 'skill' %>"
                                        class="px-2 py-2 border border-slate-200 rounded-lg bg-white focus:ring-2 focus:ring-indigo-600 outline-none">
                                        <% ['Beginner', 'Intermediate', 'Advanced'].forEach(level => { %>
                                            <option value="<%= level %>" <%= skill.proficiency === level ? 'selected' : '' %>><%= level %></option>
                                        <% }) %>
                                    </select>
                                    <button type="button" data-remove-skill-profile aria-label="Remove <%= skill.name || 'skill' %>"
                                        class="p-2 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50">
                                        <i class="ph-bold ph-trash"></i>
                                    </button>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Live PMIS Eligibility Status Preview Box in Modal -->
                    <div id="liveEligibilityPreview"
                        class="rounded-xl p-3 border border-slate-200 bg-slate-50 transition-all text-xs space-y-1.5">
                        <div class="flex items-center justify-between gap-2">
                            <span class="font-bold text-slate-700 flex items-center gap-1.5">
                                <i class="ph-bold ph-shield-check text-indigo-600"></i>
                                Live PMIS Status Preview
                            </span>
                            <span id="liveBadge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-bold text-[11px] border"></span>
                        </div>
                        <p id="liveFeedback" class="text-[11px] leading-relaxed text-slate-600"></p>
                    </div>

                    <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
                        <button type="button" id="cancelModalBtn"
                            class="px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg border border-slate-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">Cancel</button>
                        <button type="submit" id="saveProfileBtn"
                            class="px-4 py-2 font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2">Save
                            Profile</button>
                    </div>
                </form>
            </div>
        </div>


        <div id="certModal"
            class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
            <div class="bg-white border border-slate-200 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 id="certModalTitle" class="text-base font-bold text-slate-900">Add Certification</h3>
                    <button type="button" data-close-modal="certModal"
                        class="text-slate-400 hover:text-slate-600 p-1 text-lg font-bold">✕</button>
                </div>

                <form id="certForm" action="/candidate/profile/certifications" method="POST"
                    enctype="multipart/form-data" class="mt-4 space-y-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Certification Name *</label>
                        <input type="text" name="name" id="certName" required maxlength="120"
                            placeholder="e.g. Google Data Analytics"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Issuing Organization</label>
                        <input type="text" name="issuer" id="certIssuer" maxlength="120" placeholder="e.g. Coursera"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Issue Date</label>
                        <input type="date" name="issueDate" id="certIssueDate" data-max-today
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Credential Link</label>
                        <input type="url" name="link" id="certLink" placeholder="https://..."
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Certificate File (PDF/PNG/JPG, max
                            5MB)</label>
                        <input type="file" name="certificate" accept=".pdf,.png,.jpg,.jpeg" data-max-size="5242880"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 file:mr-3 file:py-1 file:px-2 file:rounded file:border-0 file:bg-slate-100 file:text-slate-700">
                        <p class="text-slate-400 mt-1" id="certFileHint">Leave empty to keep the existing file.</p>
                        <p class="text-rose-600 font-semibold mt-1 hidden" data-file-error></p>
                    </div>

                    <div class="flex items-center justify-end gap-2 pt-2">
                        <button type="button" data-close-modal="certModal"
                            class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-4 py-2 rounded-lg">Cancel</button>
                        <button type="submit"
                            class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-lg">Save
                            Certification</button>
                    </div>
                </form>
            </div>
        </div>

        <div id="projectModal"
            class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
            <div class="bg-white border border-slate-200 rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <h3 id="projectModalTitle" class="text-base font-bold text-slate-900">Add Project</h3>
                    <button type="button" data-close-modal="projectModal"
                        class="text-slate-400 hover:text-slate-600 p-1 text-lg font-bold">✕</button>
                </div>

                <form id="projectForm" action="/candidate/profile/projects" method="POST"
                    enctype="multipart/form-data" class="mt-4 space-y-3 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Project Title *</label>
                        <input type="text" name="title" id="projectTitle" required maxlength="120"
                            placeholder="e.g. InternPilot Clone"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Description</label>
                        <textarea name="description" id="projectDescription" rows="3" maxlength="1000"
                            placeholder="What does the project do?"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200"></textarea>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Tech Stack (Comma Separated)</label>
                        <input type="text" name="techStack" id="projectTechStack" placeholder="Node.js, MongoDB, EJS"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Project Link</label>
                        <input type="url" name="link" id="projectLink" placeholder="https://github.com/..."
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-200">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Supporting File (PDF/PNG/JPG, max
                            5MB)</label>
                        <input type="file" name="attachment" accept=".pdf,.png,.jpg,.jpeg" data-max-size="5242880"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 file:mr-3 file:py-1 file:px-2 file:rounded file:border-0 file:bg-slate-100 file:text-slate-700">
                        <p class="text-slate-400 mt-1" id="projectFileHint">Leave empty to keep the existing file.</p>
                        <p class="text-rose-600 font-semibold mt-1 hidden" data-file-error></p>
                    </div>

                    <div class="flex items-center justify-end gap-2 pt-2">
                        <button type="button" data-close-modal="projectModal"
                            class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold px-4 py-2 rounded-lg">Cancel</button>
                        <button type="submit"
                            class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-lg">Save
                            Project</button>
                    </div>
                </form>
            </div>
        </div>


        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const MAX_FILE_BYTES = 5 * 1024 * 1024;
                const ALLOWED_EXTENSIONS = ['.pdf', '.png', '.jpg', '.jpeg'];

                const openEntryModal = (id) => {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.classList.remove('hidden');
                    el.classList.add('flex');
                };

                const closeEntryModal = (id) => {
                    const el = document.getElementById(id);
                    if (!el) return;
                    el.classList.add('hidden');
                    el.classList.remove('flex');
                };

                document.querySelectorAll('[data-close-modal]').forEach(btn => {
                    btn.addEventListener('click', () => closeEntryModal(btn.dataset.closeModal));
                });

                const certForm = document.getElementById('certForm');
                const certTitle = document.getElementById('certModalTitle');
                const certHint = document.getElementById('certFileHint');

                const resetCertForm = () => {
                    if (certForm) certForm.reset();
                };

                document.querySelectorAll('[data-cert-add]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        resetCertForm();
                        if (certForm) certForm.action = '/candidate/profile/certifications';
                        if (certTitle) certTitle.textContent = 'Add Certification';
                        if (certHint) certHint.textContent = 'Optional. PDF, PNG or JPG up to 5MB.';
                        openEntryModal('certModal');
                    });
                });

                document.querySelectorAll('[data-cert-edit]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        resetCertForm();
                        const d = btn.dataset;
                        if (certForm) certForm.action = `/candidate/profile/certifications/${d.id}?_method=PUT`;
                        if (certTitle) certTitle.textContent = 'Edit Certification';
                        if (certHint) certHint.textContent = 'Leave empty to keep the existing file.';
                        document.getElementById('certName').value = d.name || '';
                        document.getElementById('certIssuer').value = d.issuer || '';
                        document.getElementById('certLink').value = d.link || '';
                        document.getElementById('certIssueDate').value = d.issuedate || '';
                        openEntryModal('certModal');
                    });
                });

                const projectForm = document.getElementById('projectForm');
                const projectTitle = document.getElementById('projectModalTitle');
                const projectHint = document.getElementById('projectFileHint');

                const resetProjectForm = () => {
                    if (projectForm) projectForm.reset();
                };

                document.querySelectorAll('[data-project-add]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        resetProjectForm();
                        if (projectForm) projectForm.action = '/candidate/profile/projects';
                        if (projectTitle) projectTitle.textContent = 'Add Project';
                        if (projectHint) projectHint.textContent = 'Optional. PDF, PNG or JPG up to 5MB.';
                        openEntryModal('projectModal');
                    });
                });

                document.querySelectorAll('[data-project-edit]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        resetProjectForm();
                        const d = btn.dataset;
                        if (projectForm) projectForm.action = `/candidate/profile/projects/${d.id}?_method=PUT`;
                        if (projectTitle) projectTitle.textContent = 'Edit Project';
                        if (projectHint) projectHint.textContent = 'Leave empty to keep the existing file.';
                        document.getElementById('projectTitle').value = d.title || '';
                        document.getElementById('projectDescription').value = d.description || '';
                        document.getElementById('projectLink').value = d.link || '';
                        document.getElementById('projectTechStack').value = d.techstack || '';
                        openEntryModal('projectModal');
                    });
                });

                document.querySelectorAll('input[type="date"][data-max-today]').forEach(input => {
                    input.max = new Date().toISOString().slice(0, 10);
                });

                document.querySelectorAll('input[type="file"][data-max-size]').forEach(input => {
                    const errorEl = input.parentElement.querySelector('[data-file-error]');

                    const showError = (message) => {
                        input.value = '';
                        if (!errorEl) return;
                        errorEl.textContent = message;
                        errorEl.classList.remove('hidden');
                    };

                    const clearError = () => {
                        if (errorEl) errorEl.classList.add('hidden');
                    };

                    input.addEventListener('change', () => {
                        clearError();

                        const file = input.files && input.files[0];
                        if (!file) return;

                        const name = file.name.toLowerCase();
                        const hasAllowedExtension = ALLOWED_EXTENSIONS.some(ext => name.endsWith(ext));

                        if (!hasAllowedExtension) {
                            return showError('Only PDF, PNG or JPG files are allowed.');
                        }
                        if (file.size > MAX_FILE_BYTES) {
                            return showError('File is too large. Maximum allowed size is 5MB.');
                        }
                    });
                });

                const modal = document.getElementById('editProfileModal');
                const openBtn = document.getElementById('openModalBtn');
                const closeBtn = document.getElementById('closeModalBtn');
                const cancelBtn = document.getElementById('cancelModalBtn');
                const profileForm = document.getElementById('editProfileForm');
                const saveBtn = document.getElementById('saveProfileBtn');

                // --- Reactive PMIS Eligibility Live Preview in Profile Edit Modal ---
                const editAgeInput = document.getElementById('editAge');
                const editIncomeInput = document.getElementById('editFamilyIncome');
                const editQualificationInput = document.getElementById('editQualification');
                const editEnrollmentSelect = document.getElementById('editEnrollmentStatus');
                const editEmploymentSelect = document.getElementById('editEmploymentStatus');
                const livePreviewBox = document.getElementById('liveEligibilityPreview');
                const liveBadge = document.getElementById('liveBadge');
                const liveFeedback = document.getElementById('liveFeedback');

                const updateLiveEligibility = () => {
                    if (!livePreviewBox || !liveBadge || !liveFeedback) return;

                    const ageVal = editAgeInput ? editAgeInput.value.trim() : '';
                    const incomeVal = editIncomeInput ? editIncomeInput.value.trim() : '';
                    const qualVal = editQualificationInput ? editQualificationInput.value.trim() : '';
                    const enrollVal = editEnrollmentSelect ? editEnrollmentSelect.value.trim() : '';
                    const empVal = editEmploymentSelect ? editEmploymentSelect.value.trim() : '';

                    const age = ageVal !== '' ? Number(ageVal) : null;
                    const income = incomeVal !== '' ? Number(incomeVal) : null;

                    const disqualifications = [];
                    const missing = [];

                    // Disqualification checks
                    // Values <= 0 are treated as missing, not disqualifying
                    if (age !== null && !isNaN(age) && age > 0) {
                        if (age < 21) disqualifications.push(`Age (${age}) is below minimum requirement of 21 years.`);
                        if (age > 24) disqualifications.push(`Age (${age}) exceeds maximum limit of 24 years.`);
                    } else {
                        missing.push('Age (21–24)');
                    }

                    if (income !== null && !isNaN(income) && income >= 0) {
                        if (income > 800000) disqualifications.push(`Annual income (₹${income.toLocaleString('en-IN')}) exceeds ₹8,00,000 ceiling.`);
                    } else {
                        missing.push('Family Income');
                    }

                    if (!qualVal) {
                        missing.push('Qualification');
                    }

                    if (enrollVal === 'full_time') {
                        disqualifications.push('Candidates enrolled in full-time formal education are not eligible.');
                    } else if (!enrollVal) {
                        missing.push('Enrollment Status');
                    }

                    if (empVal === 'full_time') {
                        disqualifications.push('Candidates in full-time regular employment are not eligible.');
                    } else if (!empVal) {
                        missing.push('Employment Status');
                    }

                    // Reset classes
                    livePreviewBox.className = 'rounded-xl p-3 border transition-all text-xs space-y-1.5';
                    liveBadge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-bold text-[11px] border';

                    if (disqualifications.length > 0) {
                        livePreviewBox.classList.add('bg-rose-50/70', 'border-rose-200');
                        liveBadge.classList.add('bg-rose-100', 'text-rose-700', 'border-rose-200');
                        liveBadge.innerHTML = '<i class="ph-bold ph-x-circle"></i> Not Eligible';
                        liveFeedback.className = 'text-[11px] text-rose-700 font-medium';
                        liveFeedback.innerHTML = '<strong>Disqualifying criteria:</strong> ' + disqualifications.join(' ');
                    } else if (missing.length > 0) {
                        livePreviewBox.classList.add('bg-amber-50/70', 'border-amber-200');
                        liveBadge.classList.add('bg-amber-100', 'text-amber-800', 'border-amber-200');
                        liveBadge.innerHTML = '<i class="ph-bold ph-warning-circle"></i> Incomplete';
                        liveFeedback.className = 'text-[11px] text-amber-800';
                        liveFeedback.innerHTML = '<strong>Missing required fields:</strong> ' + missing.join(', ') + '. Fill these in to confirm eligibility.';
                    } else {
                        livePreviewBox.classList.add('bg-emerald-50/70', 'border-emerald-200');
                        liveBadge.classList.add('bg-emerald-100', 'text-emerald-700', 'border-emerald-200');
                        liveBadge.innerHTML = '<i class="ph-bold ph-check-circle"></i> Eligible';
                        liveFeedback.className = 'text-[11px] text-emerald-700 font-medium';
                        liveFeedback.innerHTML = '✓ All PMIS eligibility criteria satisfied! Save your profile to finalize.';
                    }
                };

                [editAgeInput, editIncomeInput, editQualificationInput, editEnrollmentSelect, editEmploymentSelect].forEach(input => {
                    if (input) {
                        input.addEventListener('input', updateLiveEligibility);
                        input.addEventListener('change', updateLiveEligibility);
                    }
                });

                if (openBtn && modal) {
                    openBtn.addEventListener('click', () => {
                        modal.classList.remove('hidden');
                        updateLiveEligibility();
                    });
                }

                const closeModal = () => {
                    if (modal) modal.classList.add('hidden');
                };

                if (closeBtn) closeBtn.addEventListener('click', closeModal);
                if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

                const skillProfileFields = document.getElementById('skillProfileFields');
                const addSkillProfileBtn = document.getElementById('addSkillProfileBtn');

                const addSkillProfileRow = () => {
                    if (!skillProfileFields) return;
                    const row = document.createElement('div');
                    row.dataset.skillProfileRow = '';
                    row.className = 'grid grid-cols-[minmax(0,1fr)_auto_auto] gap-2 items-center';

                    const nameInput = document.createElement('input');
                    nameInput.type = 'text';
                    nameInput.name = 'skillName';
                    nameInput.maxLength = 80;
                    nameInput.placeholder = 'e.g. JavaScript';
                    nameInput.setAttribute('aria-label', 'Skill name');
                    nameInput.className = 'min-w-0 px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-600 outline-none';

                    const proficiencySelect = document.createElement('select');
                    proficiencySelect.name = 'skillProficiency';
                    proficiencySelect.setAttribute('aria-label', 'Proficiency for new skill');
                    proficiencySelect.className = 'px-2 py-2 border border-slate-200 rounded-lg bg-white focus:ring-2 focus:ring-indigo-600 outline-none';
                    ['Beginner', 'Intermediate', 'Advanced'].forEach(level => {
                        const option = new Option(level, level, level === 'Intermediate', level === 'Intermediate');
                        proficiencySelect.add(option);
                    });

                    const removeButton = document.createElement('button');
                    removeButton.type = 'button';
                    removeButton.dataset.removeSkillProfile = '';
                    removeButton.setAttribute('aria-label', 'Remove skill');
                    removeButton.className = 'p-2 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50';
                    removeButton.innerHTML = '<i class="ph-bold ph-trash"></i>';

                    row.append(nameInput, proficiencySelect, removeButton);
                    skillProfileFields.append(row);
                    nameInput.focus();
                };

                if (addSkillProfileBtn) addSkillProfileBtn.addEventListener('click', addSkillProfileRow);
                if (skillProfileFields) {
                    skillProfileFields.addEventListener('click', event => {
                        const removeButton = event.target.closest('[data-remove-skill-profile]');
                        if (removeButton) removeButton.closest('[data-skill-profile-row]')?.remove();
                    });
                }

                if (profileForm && saveBtn) {
                    profileForm.addEventListener('submit', () => {
                        saveBtn.disabled = true;
                        if (cancelBtn) cancelBtn.disabled = true;
                        if (closeBtn) closeBtn.disabled = true;
                        saveBtn.innerHTML = `
                            <svg class="animate-spin h-4 w-4 text-white shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Saving...
                        `;
                    });
                }

                // ── Resume Upload & Status Interactions ──────────────────
                const resumeUploadCard = document.getElementById('resumeUploadCard');
                const resumeFormWrapper = document.getElementById('resumeFormWrapper');
                const toggleReplaceBtn = document.getElementById('toggleReplaceResumeBtn');
                const cancelReplaceBtn = document.getElementById('cancelReplaceBtn');
                const resumeDropzone = document.getElementById('resumeDropzone');
                const resumeInput = document.getElementById('resumeInput');
                const filePreview = document.getElementById('fileSelectionPreview');
                const previewName = document.getElementById('previewFileName');
                const previewSize = document.getElementById('previewFileSize');
                const previewIcon = document.getElementById('previewFileIcon');
                const clearFileBtn = document.getElementById('clearFileBtn');
                const resumeClientError = document.getElementById('resumeClientError');
                const resumeClientErrorText = document.getElementById('resumeClientErrorText');
                const resumeUploadForm = document.getElementById('resumeUploadForm');

                window.showResumeReplace = function () {
                    if (resumeFormWrapper) resumeFormWrapper.classList.remove('hidden');
                    if (resumeUploadCard) resumeUploadCard.scrollIntoView({ behavior: 'smooth' });
                    if (resumeInput) resumeInput.click();
                };

                if (toggleReplaceBtn && resumeFormWrapper) {
                    toggleReplaceBtn.addEventListener('click', () => {
                        resumeFormWrapper.classList.toggle('hidden');
                        if (!resumeFormWrapper.classList.contains('hidden') && resumeInput) {
                            resumeInput.focus();
                        }
                    });
                }

                if (cancelReplaceBtn && resumeFormWrapper) {
                    cancelReplaceBtn.addEventListener('click', () => {
                        resumeFormWrapper.classList.add('hidden');
                        if (resumeInput) resumeInput.value = '';
                        if (filePreview) {
                            filePreview.classList.add('hidden');
                            filePreview.classList.remove('flex');
                        }
                        if (resumeClientError) resumeClientError.classList.add('hidden');
                    });
                }

                if (resumeDropzone && resumeInput) {
                    resumeDropzone.addEventListener('click', () => resumeInput.click());

                    ['dragenter', 'dragover'].forEach(eventName => {
                        resumeDropzone.addEventListener(eventName, (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            resumeDropzone.classList.add('border-indigo-500', 'bg-indigo-100/50');
                        });
                    });

                    ['dragleave', 'drop'].forEach(eventName => {
                        resumeDropzone.addEventListener(eventName, (e) => {
                            e.preventDefault();
                            e.stopPropagation();
                            resumeDropzone.classList.remove('border-indigo-500', 'bg-indigo-100/50');
                        });
                    });

                    resumeDropzone.addEventListener('drop', (e) => {
                        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                            resumeInput.files = e.dataTransfer.files;
                            handleFileSelection(e.dataTransfer.files[0]);
                        }
                    });
                }

                const handleFileSelection = (file) => {
                    if (!file) return;

                    const maxBytes = 5 * 1024 * 1024;
                    const allowedExts = ['.pdf', '.doc', '.docx'];
                    const ext = '.' + (file.name.split('.').pop() || '').toLowerCase();

                    // Check file extension
                    if (!allowedExts.includes(ext)) {
                        if (resumeClientError && resumeClientErrorText) {
                            resumeClientErrorText.textContent = `Invalid file format (${ext}). Only PDF (.pdf) and Word (.docx, .doc) resumes are supported.`;
                            resumeClientError.classList.remove('hidden');
                        }
                        if (filePreview) {
                            filePreview.classList.add('hidden');
                            filePreview.classList.remove('flex');
                        }
                        if (resumeInput) resumeInput.value = '';
                        return;
                    }

                    // Check file size
                    if (file.size > maxBytes) {
                        const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
                        if (resumeClientError && resumeClientErrorText) {
                            resumeClientErrorText.textContent = `File is too large (${sizeMb}MB). Maximum allowed resume size is 5MB.`;
                            resumeClientError.classList.remove('hidden');
                        }
                        if (filePreview) {
                            filePreview.classList.add('hidden');
                            filePreview.classList.remove('flex');
                        }
                        if (resumeInput) resumeInput.value = '';
                        return;
                    }

                    // Valid file
                    if (resumeClientError) resumeClientError.classList.add('hidden');
                    if (filePreview && previewName && previewSize && previewIcon) {
                        previewName.textContent = file.name;
                        previewSize.textContent = `${(file.size / 1024).toFixed(0)} KB · Ready to upload`;
                        previewIcon.className = ext === '.pdf' ? 'ph-bold ph-file-pdf text-base' : 'ph-bold ph-file-doc text-base';
                        filePreview.classList.remove('hidden');
                        filePreview.classList.add('flex');
                    }
                };

                if (resumeInput) {
                    resumeInput.addEventListener('change', () => {
                        if (resumeInput.files && resumeInput.files[0]) {
                            handleFileSelection(resumeInput.files[0]);
                        }
                    });
                }

                if (clearFileBtn) {
                    clearFileBtn.addEventListener('click', () => {
                        if (resumeInput) resumeInput.value = '';
                        if (filePreview) {
                            filePreview.classList.add('hidden');
                            filePreview.classList.remove('flex');
                        }
                        if (resumeClientError) resumeClientError.classList.add('hidden');
                    });
                }

                if (resumeUploadForm) {
                    resumeUploadForm.addEventListener('submit', (e) => {
                        if (!resumeInput || !resumeInput.files || resumeInput.files.length === 0) {
                            e.preventDefault();
                            if (resumeClientError && resumeClientErrorText) {
                                resumeClientErrorText.textContent = 'Please select a resume file (PDF or Word) before uploading.';
                                resumeClientError.classList.remove('hidden');
                            }
                            return;
                        }
                    });
                }
            });
        </script>
