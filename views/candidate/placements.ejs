<% layout('layouts/boilerplate') %>
<%
    const statusLabel = value => String(value || '').replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
    const companyName = placement => placement.company?.companyDetails?.companyName || placement.company?.name || 'Company';
%>

<div class="mx-auto max-w-5xl space-y-6">
    <header class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Internship lifecycle</p>
            <h1 class="mt-1 text-3xl font-bold text-slate-900">My placements</h1>
            <p class="mt-2 text-sm text-slate-600">Confirm joining, record your progress, and complete each internship in one place.</p>
        </div>
        <a href="/candidate/applications" class="text-sm font-semibold text-indigo-700 hover:underline">View applications</a>
    </header>

    <% if (!placements.length) { %>
        <section class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center shadow-sm">
            <i class="ph-bold ph-briefcase text-4xl text-slate-300" aria-hidden="true"></i>
            <h2 class="mt-3 text-lg font-bold text-slate-800">No placements yet</h2>
            <p class="mt-1 text-sm text-slate-600">A placement appears here after you accept an internship offer.</p>
        </section>
    <% } else { %>
        <div class="grid gap-4 md:grid-cols-2">
            <% placements.forEach(placement => { %>
                <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900"><%= placement.internship?.title || 'Internship placement' %></h2>
                            <p class="mt-1 text-sm text-slate-600"><%= companyName(placement) %></p>
                        </div>
                        <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-bold text-indigo-700"><%= statusLabel(placement.status) %></span>
                    </div>
                    <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
                        <div><dt class="text-xs text-slate-500">Start</dt><dd class="mt-1 font-semibold text-slate-800"><%= new Date(placement.startDate).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %></dd></div>
                        <div><dt class="text-xs text-slate-500">End</dt><dd class="mt-1 font-semibold text-slate-800"><%= placement.endDate ? new Date(placement.endDate).toLocaleDateString('en-IN', { dateStyle: 'medium' }) : 'To be confirmed' %></dd></div>
                    </dl>
                    <a href="/candidate/placements/<%= placement._id %>" class="mt-5 inline-flex w-full items-center justify-center rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-indigo-700">Manage placement</a>
                </article>
            <% }) %>
        </div>
    <% } %>
</div>
