<% layout('layouts/boilerplate') %>
<% const permissionList = typeof permissions !== 'undefined' && Array.isArray(permissions) ? permissions : []; %>
<% const canCreateInternship = permissionList.includes('internship:create'); %>
<% const canEditInternship = permissionList.includes('internship:edit'); %>
<% const canDeleteInternship = permissionList.includes('internship:delete'); %>
<% const canViewApplications = permissionList.includes('applications:view'); %>

    <% if (typeof overview !== 'undefined' && overview) { %><%- include('../partials/recruiter-overview') %><% } %>

    <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-3 gap-8">

        <% if (canCreateInternship) { %>
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm h-fit">
            <h2 class="text-lg font-bold text-slate-900 mb-4 border-b pb-2">Post New Opportunity</h2>

            <form id="vacancy-form" action="/company/internships/create" method="POST" class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Internship Title</label>
                    <input type="text" name="title" required placeholder="e.g. Software Development Intern"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Sector</label>
                        <input type="text" name="sector" placeholder="IT, Finance, Core"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Vacancies</label>
                        <input type="number" name="vacancies" value="1" min="1"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Required Skills (Comma Separated)</label>
                    <input type="text" name="requiredSkills" placeholder="JavaScript, Python, SQL"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Min Qualifications</label>
                    <input type="text" name="minQualifications" placeholder="e.g. B.Tech / BCA"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Monthly Stipend (₹)</label>
                        <input type="number" name="monthlyStipend" value="5000"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">Duration</label>
                        <input type="text" name="duration" value="12 Months" placeholder="e.g. 12 Months"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">District</label>
                        <input type="text" name="district" placeholder="e.g. Ghaziabad"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-700 mb-1">State</label>
                        <input type="text" name="state" placeholder="e.g. Uttar Pradesh"
                            class="w-full px-3 py-2 border rounded-lg border-slate-300">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Internship Description</label>
                    <textarea name="description" rows="4" placeholder="Describe responsibilities, projects, tasks, and expectations..."
                        class="w-full px-3 py-2 border rounded-lg border-slate-300 resize-y"></textarea>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Day-to-Day Responsibilities <span class="font-normal text-slate-400">(one per line)</span></label>
                    <textarea name="responsibilities" rows="4" placeholder="Work on assigned projects&#10;Collaborate with the engineering team&#10;Prepare weekly progress updates"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300 resize-y"></textarea>
                </div>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Eligibility Criteria <span class="font-normal text-slate-400">(one per line)</span></label>
                    <textarea name="eligibilityCriteria" rows="3" placeholder="B.Tech/BE students&#10;Basic knowledge of JavaScript&#10;Good communication skills"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300 resize-y"></textarea>
                </div>

                <%- include('../partials/application-question-builder', { applicationQuestions: [] }) %>

                <div>
                    <label class="block font-semibold text-slate-700 mb-1">Application Deadline (Optional)</label>
                    <input type="date" name="deadline"
                        class="w-full px-3 py-2 border rounded-lg border-slate-300 text-slate-600">
                </div>

                <div class="flex gap-2">
                    <button type="submit" name="action" value="draft" formnovalidate
                        class="w-1/2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold py-2.5 rounded-lg transition-colors border border-slate-300 shadow-sm text-center cursor-pointer">
                    Save as Draft
                    </button>

                    <button type="submit" name="action" value="publish"
                        class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg transition-colors shadow-sm text-center cursor-pointer">

                    Publish Opportunity
                    </button>
                </div>
            </form>
            <script>
                function handleFormReset() {
                    const vacancyForm = document.getElementById('vacancy-form');
                    const hasMeaningfulData = Array.from(vacancyForm.elements)
                        .filter((element) => element.name)
                        .some((element) => element.value !== element.defaultValue);

                    if (!hasMeaningfulData || confirm('Are you sure you want to reset the form?')) {
                        vacancyForm.reset();
                    }
                }
            </script>
        </div>
        <% } %>

        <!-- Right Column: Active Internships & Drafts -->
        <div class="<%= canCreateInternship ? 'lg:col-span-2' : 'lg:col-span-3' %> space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b pb-3">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Your Posted Internships</h2>
                    <p class="text-xs text-slate-500">Manage published roles and complete saved drafts.</p>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <% if (user && ['company', 'recruiter'].includes(user.role)) { %>
                    <a href="/company/profile"
                        class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-full transition-colors">
                        <i class="ph-bold ph-user-gear"></i> Company Profile
                    </a>
                    <% } %>
                    <span class="text-xs font-semibold bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full self-start sm:self-auto">
                        Total Applications: <%= totalApplicationsCount %>
                    </span>
                </div>
            </div>

            <!-- Status Filter Tabs & Sort Controls -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-2.5">
                <!-- Status Filter Tabs -->
                <div class="flex items-center gap-2 text-xs font-medium flex-wrap">
                    <% const dashboardFilterUrl = status => `/company/dashboard?status=${encodeURIComponent(status)}&sort=${encodeURIComponent(currentSort || 'newest')}`; %>
                    <a href="<%= dashboardFilterUrl('all') %>"
                        class="status-filter-tab px-3 py-1.5 rounded-lg transition-colors <%= currentFilter === 'all' ? 'bg-indigo-600 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100' %>"
                        data-status="all" <%= currentFilter === 'all' ? 'aria-current="page"' : '' %>>
                        All (<%= typeof totalCount !== 'undefined' ? totalCount : (internships ? internships.length : 0) %>)
                    </a>
                    <a href="<%= dashboardFilterUrl('active') %>"
                        class="status-filter-tab px-3 py-1.5 rounded-lg transition-colors <%= currentFilter === 'active' ? 'bg-emerald-600 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100' %>"
                        data-status="active" <%= currentFilter === 'active' ? 'aria-current="page"' : '' %>>
                        Active (<%= typeof activeCount !== 'undefined' ? activeCount : 0 %>)
                    </a>
                    <a href="<%= dashboardFilterUrl('closed') %>"
                        class="status-filter-tab px-3 py-1.5 rounded-lg transition-colors <%= currentFilter === 'closed' ? 'bg-amber-600 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100' %>"
                        data-status="closed" <%= currentFilter === 'closed' ? 'aria-current="page"' : '' %>>
                        Closed (<%= typeof closedCount !== 'undefined' ? closedCount : 0 %>)
                    </a>
                    <a href="<%= dashboardFilterUrl('draft') %>"
                        class="status-filter-tab px-3 py-1.5 rounded-lg transition-colors <%= currentFilter === 'draft' ? 'bg-slate-700 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100' %>"
                        data-status="draft" <%= currentFilter === 'draft' ? 'aria-current="page"' : '' %>>
                        Drafts (<%= typeof draftCount !== 'undefined' ? draftCount : 0 %>)
                    </a>
                    <a href="<%= dashboardFilterUrl('expired') %>"
                        class="status-filter-tab px-3 py-1.5 rounded-lg transition-colors <%= currentFilter === 'expired' ? 'bg-rose-600 text-white font-semibold shadow-xs' : 'text-slate-600 hover:bg-slate-100' %>"
                        data-status="expired" <%= currentFilter === 'expired' ? 'aria-current="page"' : '' %>>
                        Expired (<%= typeof expiredCount !== 'undefined' ? expiredCount : 0 %>)
                    </a>
                </div>

                <!-- Upscaled Custom Sort Dropdown (with synchronized underlying select) -->
                <div class="relative" id="customSortWrapper">
                    <!-- Screen-reader / programmatic select element for 100% test & form compatibility -->
                    <select id="sortInternships"
                        aria-label="Sort internships"
                        class="sr-only"
                        tabindex="-1"
                        data-status="<%= currentFilter %>">
                        <option value="newest" <%= (typeof currentSort === 'undefined' || currentSort === 'newest') ? 'selected' : '' %>>Newest</option>
                        <option value="oldest" <%= (typeof currentSort !== 'undefined' && currentSort === 'oldest') ? 'selected' : '' %>>Oldest</option>
                        <option value="title" <%= currentSort === 'title' ? 'selected' : '' %>>Title (A-Z)</option>
                        <option value="most_applications" <%= (typeof currentSort !== 'undefined' && (currentSort === 'most_applications' || currentSort === 'applications' || currentSort === 'applications_desc')) ? 'selected' : '' %>>Most Applications</option>
                        <option value="deadline" <%= (typeof currentSort !== 'undefined' && (currentSort === 'deadline' || currentSort === 'deadline_soonest' || currentSort === 'deadline_asc')) ? 'selected' : '' %>>Application Deadline (soonest first)</option>
                    </select>

                    <!-- Upscaled Custom Dropdown Trigger Button -->
                    <button type="button"
                        id="sortDropdownButton"
                        aria-haspopup="listbox"
                        aria-expanded="false"
                        class="flex items-center justify-between gap-2.5 bg-white hover:bg-slate-50 border border-slate-200 hover:border-slate-300 text-slate-700 font-semibold text-xs px-3.5 py-2 rounded-xl shadow-xs transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 cursor-pointer min-w-[210px]">
                        <span class="flex items-center gap-2 truncate">
                            <i class="ph-bold ph-arrows-down-up text-indigo-600 text-sm"></i>
                            <span id="sortDropdownLabel" class="truncate">
                                <% if (currentSort === 'title') { %>
                                    Title (A-Z)
                                <% } else if (typeof currentSort !== 'undefined' && currentSort === 'oldest') { %>
                                    Oldest
                                <% } else if (typeof currentSort !== 'undefined' && (currentSort === 'most_applications' || currentSort === 'applications' || currentSort === 'applications_desc')) { %>
                                    Most Applications
                                <% } else if (typeof currentSort !== 'undefined' && (currentSort === 'deadline' || currentSort === 'deadline_soonest' || currentSort === 'deadline_asc')) { %>
                                    Application Deadline (soonest first)
                                <% } else { %>
                                    Newest
                                <% } %>
                            </span>
                        </span>
                        <i class="ph-bold ph-caret-down text-slate-400 text-xs transition-transform duration-200" id="sortDropdownCaret"></i>
                    </button>

                    <!-- Upscaled Custom Options Menu -->
                    <div id="sortDropdownMenu"
                        role="listbox"
                        aria-labelledby="sortDropdownButton"
                        class="hidden absolute right-0 mt-1.5 w-64 bg-white border border-slate-200/90 rounded-xl shadow-xl shadow-slate-300/40 p-1.5 z-50 transition-all duration-150 transform origin-top-right">
                        <div class="px-2.5 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100 mb-1">
                            Sort Internships By
                        </div>
                        <button type="button"
                            role="option"
                            data-value="newest"
                            class="sort-option-item w-full flex items-center justify-between gap-2 px-3 py-2 text-xs rounded-lg transition-colors cursor-pointer text-left <%= (typeof currentSort === 'undefined' || currentSort === 'newest') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 font-medium' %>">
                            <span class="flex items-center gap-2.5">
                                <i class="ph-bold ph-clock-countdown text-sm <%= (typeof currentSort === 'undefined' || currentSort === 'newest') ? 'text-indigo-600' : 'text-slate-400' %>"></i>
                                <span>Newest</span>
                            </span>
                            <i class="ph-bold ph-check text-indigo-600 text-sm <%= (typeof currentSort === 'undefined' || currentSort === 'newest') ? '' : 'hidden' %>"></i>
                        </button>

                        <button type="button"
                            role="option"
                            data-value="title"
                            class="sort-option-item w-full flex items-center justify-between gap-2 px-3 py-2 text-xs rounded-lg transition-colors cursor-pointer text-left <%= currentSort === 'title' ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 font-medium' %>">
                            <span class="flex items-center gap-2.5">
                                <i class="ph-bold ph-text-aa text-sm <%= currentSort === 'title' ? 'text-indigo-600' : 'text-slate-400' %>"></i>
                                <span>Title (A-Z)</span>
                            </span>
                            <i class="ph-bold ph-check text-indigo-600 text-sm <%= currentSort === 'title' ? '' : 'hidden' %>"></i>
                        </button>

                        <button type="button"
                            role="option"
                            data-value="oldest"
                            class="sort-option-item w-full flex items-center justify-between gap-2 px-3 py-2 text-xs rounded-lg transition-colors cursor-pointer text-left <%= (typeof currentSort !== 'undefined' && currentSort === 'oldest') ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 font-medium' %>">
                            <span class="flex items-center gap-2.5">
                                <i class="ph-bold ph-hourglass text-sm <%= (typeof currentSort !== 'undefined' && currentSort === 'oldest') ? 'text-indigo-600' : 'text-slate-400' %>"></i>
                                <span>Oldest</span>
                            </span>
                            <i class="ph-bold ph-check text-indigo-600 text-sm <%= (typeof currentSort !== 'undefined' && currentSort === 'oldest') ? '' : 'hidden' %>"></i>
                        </button>

                        <button type="button"
                            role="option"
                            data-value="most_applications"
                            class="sort-option-item w-full flex items-center justify-between gap-2 px-3 py-2 text-xs rounded-lg transition-colors cursor-pointer text-left <%= (typeof currentSort !== 'undefined' && (currentSort === 'most_applications' || currentSort === 'applications' || currentSort === 'applications_desc')) ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 font-medium' %>">
                            <span class="flex items-center gap-2.5">
                                <i class="ph-bold ph-users text-sm <%= (typeof currentSort !== 'undefined' && (currentSort === 'most_applications' || currentSort === 'applications' || currentSort === 'applications_desc')) ? 'text-indigo-600' : 'text-slate-400' %>"></i>
                                <span>Most Applications</span>
                            </span>
                            <i class="ph-bold ph-check text-indigo-600 text-sm <%= (typeof currentSort !== 'undefined' && (currentSort === 'most_applications' || currentSort === 'applications' || currentSort === 'applications_desc')) ? '' : 'hidden' %>"></i>
                        </button>

                        <button type="button"
                            role="option"
                            data-value="deadline"
                            class="sort-option-item w-full flex items-center justify-between gap-2 px-3 py-2 text-xs rounded-lg transition-colors cursor-pointer text-left <%= (typeof currentSort !== 'undefined' && (currentSort === 'deadline' || currentSort === 'deadline_soonest' || currentSort === 'deadline_asc')) ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-700 hover:bg-slate-50 hover:text-slate-900 font-medium' %>">
                            <span class="flex items-center gap-2.5">
                                <i class="ph-bold ph-calendar text-sm <%= (typeof currentSort !== 'undefined' && (currentSort === 'deadline' || currentSort === 'deadline_soonest' || currentSort === 'deadline_asc')) ? 'text-indigo-600' : 'text-slate-400' %>"></i>
                                <span>Application Deadline (soonest first)</span>
                            </span>
                            <i class="ph-bold ph-check text-indigo-600 text-sm <%= (typeof currentSort !== 'undefined' && (currentSort === 'deadline' || currentSort === 'deadline_soonest' || currentSort === 'deadline_asc')) ? '' : 'hidden' %>"></i>
                        </button>
                    </div>
                </div>
            </div>

            <% if (internships && internships.length > 0) { %>
                <div class="space-y-4" id="internshipsContainer">
                    <% internships.forEach(internship => { %>
                        <% const isInternshipPaused = internship.status === 'paused' || internship.isPaused; %>
                        <% const appCount = (typeof appCountMap !== 'undefined' && appCountMap[internship._id.toString()]) ? appCountMap[internship._id.toString()] : 0; %>
                        <% const deadlineTs = internship.applicationDeadline ? new Date(internship.applicationDeadline).getTime() : ''; %>
                        <div class="internship-card bg-white border <%= internship.status === 'draft' ? 'border-amber-200 bg-amber-50/20' : (isInternshipPaused ? 'border-amber-300 bg-amber-50/15' : 'border-slate-200') %> rounded-xl p-5 shadow-sm space-y-3"
                            data-id="<%= internship._id.toString() %>"
                            data-posted="<%= internship._id.getTimestamp().getTime() %>"
                            data-applications="<%= appCount %>"
                            data-deadline="<%= deadlineTs %>">
                            <div class="flex justify-between items-start gap-3">
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <h3 class="font-bold text-slate-800 text-base">
                                            <%= internship.title %>
                                        </h3>
                                        <% if (internship.status === 'draft') { %>
                                            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-300 flex items-center gap-1">
                                                <i class="ph-bold ph-pencil-simple-line"></i> Draft
                                            </span>
                                        <% } else if (isInternshipPaused) { %>
                                            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-300 flex items-center gap-1">
                                                <i class="ph-bold ph-pause-circle"></i> Applications Paused
                                            </span>
                                        <% } else { %>
                                            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 flex items-center gap-1">
                                                <i class="ph-bold ph-check-circle"></i> Published
                                            </span>
                                        <% } %>
                                    </div>
                                    <p class="text-xs text-slate-500 mt-0.5">
                                        Sector: <%= internship.sector || 'N/A' %> | Location: <%=
                                                internship.location?.district || 'Remote' %>, <%=
                                                    internship.location?.state || '' %>
                                    </p>
                                </div>
                                <span
                                    class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 whitespace-nowrap">
                                    ₹<%= (internship.monthlyStipend ?? 5000).toLocaleString('en-IN') %>/mo
                                </span>
                            </div>

                            <div class="text-xs text-slate-600 space-y-1">
                                <p><strong>Min Qualifications:</strong>
                                    <%= internship.minQualifications || 'Any' %>
                                </p>
                                <p><strong>Vacancies:</strong>
                                    <%= internship.vacancies %> | <strong>Duration:</strong>
                                        <%= internship.duration || '12 Months' %>
                                </p>
                                <p>
                                    <strong>Deadline:</strong>
                                    <% if (internship.applicationDeadline) { %>
                                        <span class="<%= new Date() > internship.applicationDeadline ? 'text-rose-600 font-semibold' : 'text-slate-600' %>">
                                            <%= new Date(internship.applicationDeadline).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                            <%= new Date() > internship.applicationDeadline ? '(Closed)' : '' %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-slate-500 italic">No deadline</span>
                                    <% } %>
                                </p>
                            </div>

                            <% if (internship.requiredSkills && internship.requiredSkills.length > 0) { %>
                                <div class="flex flex-wrap gap-1.5 pt-1">
                                    <% internship.requiredSkills.forEach(skill => { %>
                                        <span
                                            class="bg-indigo-50 border border-indigo-100 text-indigo-700 text-[10px] font-semibold px-2.5 py-1 rounded-md">
                                            <%= skill %>
                                        </span>
                                    <% }) %>
                                </div>
                            <% } %>

                            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 flex-wrap">
                                <% if (canEditInternship && internship.status === 'draft') { %>
                                    <!-- Quick Publish Action Form -->
                                    <form action="/company/internships/publish/<%= internship._id %>" method="POST">
                                        <button type="submit"
                                            class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs px-3.5 py-2 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm">
                                            <i class="ph-bold ph-paper-plane-tilt text-sm"></i>
                                            Publish Now
                                        </button>
                                    </form>
                                <% } else if (canEditInternship && isInternshipPaused) { %>
                                    <!-- Resume Applications Action Form -->
                                    <form action="/company/internships/<%= internship._id %>/resume" method="POST" class="inline">
                                        <button type="submit"
                                            class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs px-3.5 py-2 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm"
                                            title="Resume accepting applications for this listing">
                                            <i class="ph-bold ph-play text-sm"></i>
                                            Resume Applications
                                        </button>
                                    </form>
                                <% } else if (canEditInternship) { %>
                                    <!-- Pause Applications Action Form -->
                                    <form action="/company/internships/<%= internship._id %>/pause" method="POST" class="inline">
                                        <button type="submit"
                                            class="bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-300 font-semibold text-xs px-3.5 py-2 rounded-lg transition-colors flex items-center gap-1.5 shadow-xs"
                                            title="Temporarily stop receiving new applications">
                                            <i class="ph-bold ph-pause text-sm"></i>
                                            Pause Applications
                                        </button>
                                    </form>
                                <% } %>

                                <% if (canEditInternship) { %>
                                <!-- Edit Button -->
                                <a href="/company/internships/edit/<%= internship._id %>"
                                    class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-4 py-2 rounded-lg transition-colors flex items-center gap-1.5">
                                    <i class="ph-bold ph-pencil-simple text-sm"></i>
                                    Edit
                                </a>
                                <% } %>

                                <% if (canDeleteInternship) { %>
                                <!-- Delete Button Form -->
                                <form action="/company/internships/delete/<%= internship._id %>" method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this internship?');">
                                    <button type="submit"
                                        class="bg-red-50 hover:bg-red-100 text-red-600 font-semibold text-xs px-4 py-2 rounded-lg transition-colors flex items-center gap-1.5">
                                        <i class="ph-bold ph-trash text-sm"></i>
                                        Delete
                                    </button>
                                </form>
                                <% } %>

                                <% if (canViewApplications) { %>
                                <!-- View Applicants Button -->
                                <% const hasExistingApps = appCount > 0; %>
                                <% if (internship.status === 'draft' && !hasExistingApps) { %>
                                    <span class="bg-slate-100 text-slate-400 font-semibold text-xs px-3.5 py-2 rounded-lg flex items-center gap-1.5 cursor-not-allowed"
                                        title="Drafts cannot receive applicants until published.">
                                        <i class="ph-bold ph-lock-key text-sm"></i>
                                        No Applicants
                                    </span>
                                <% } else { %>
                                    <a href="/company/internships/<%= internship._id %>/applicants"
                                        class="bg-slate-800 hover:bg-slate-900 text-white font-semibold text-xs px-4 py-2 rounded-lg transition-colors flex items-center gap-1.5">
                                        View Applicants (<%= appCount %>) &rarr;
                                    </a>
                                <% } %>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="bg-white border border-slate-200 rounded-xl p-8 text-center text-slate-500 text-sm">
                    <% const emptyStateMessages = {
                        all: 'No internships posted yet.',
                        active: 'No active listings found.',
                        closed: 'No closed listings found.',
                        draft: 'No draft listings found.',
                        expired: 'No expired listings found.'
                    }; %>
                    <%= emptyStateMessages[currentFilter] || emptyStateMessages.all %>
                </div>
            <% } %>

            <% if (typeof pageCount !== 'undefined' && pageCount > 1) { %>
                <nav aria-label="Internship listing pages" class="flex items-center justify-between border-t border-slate-200 pt-4 text-sm">
                    <span class="text-slate-500">Page <%= currentPage %> of <%= pageCount %></span>
                    <div class="flex items-center gap-2">
                        <% if (previousPageUrl) { %>
                            <a href="<%= previousPageUrl %>" rel="prev" class="rounded-lg border border-slate-200 px-3 py-2 font-medium text-slate-700 transition-colors hover:bg-slate-50">Previous</a>
                        <% } %>
                        <% if (nextPageUrl) { %>
                            <a href="<%= nextPageUrl %>" rel="next" class="rounded-lg border border-slate-200 px-3 py-2 font-medium text-slate-700 transition-colors hover:bg-slate-50">Next</a>
                        <% } %>
                    </div>
                </nav>
            <% } %>
        </div>

    </div>

    <script>
        const sortInternships = document.getElementById('sortInternships');
        const sortDropdownButton = document.getElementById('sortDropdownButton');
        const sortDropdownMenu = document.getElementById('sortDropdownMenu');
        const sortDropdownCaret = document.getElementById('sortDropdownCaret');
        const sortDropdownLabel = document.getElementById('sortDropdownLabel');
        const sortOptionItems = document.querySelectorAll('.sort-option-item');

        const optionLabels = {
            'newest': 'Newest',
            'oldest': 'Oldest',
            'title': 'Title (A-Z)',
            'most_applications': 'Most Applications',
            'deadline': 'Application Deadline (soonest first)'
        };

        function updateCustomDropdownUI(sortValue) {
            if (sortDropdownLabel) {
                sortDropdownLabel.textContent = optionLabels[sortValue] || 'Newest';
            }

            sortOptionItems.forEach(item => {
                const isSelected = item.dataset.value === sortValue;

                const icon = item.querySelector('.ph-bold:first-child');
                const check = item.querySelector('.ph-check');

                if (isSelected) {
                    item.className = 'sort-option-item w-full flex items-center justify-between gap-2 px-3 py-2 text-xs rounded-lg transition-colors cursor-pointer text-left bg-indigo-50 text-indigo-700 font-semibold';
                    if (icon) {
                        icon.classList.remove('text-slate-400');
                        icon.classList.add('text-indigo-600');
                    }
                    if (check) check.classList.remove('hidden');
                } else {
                    item.className = 'sort-option-item w-full flex items-center justify-between gap-2 px-3 py-2 text-xs rounded-lg transition-colors cursor-pointer text-left text-slate-700 hover:bg-slate-50 hover:text-slate-900 font-medium';
                    if (icon) {
                        icon.classList.remove('text-indigo-600');
                        icon.classList.add('text-slate-400');
                    }
                    if (check) check.classList.add('hidden');
                }
            });
        }

        function toggleDropdown(open) {
            if (!sortDropdownMenu) return;
            const shouldOpen = typeof open === 'boolean' ? open : sortDropdownMenu.classList.contains('hidden');
            if (shouldOpen) {
                sortDropdownMenu.classList.remove('hidden');
                sortDropdownButton?.setAttribute('aria-expanded', 'true');
                sortDropdownCaret?.classList.add('rotate-180');
            } else {
                sortDropdownMenu.classList.add('hidden');
                sortDropdownButton?.setAttribute('aria-expanded', 'false');
                sortDropdownCaret?.classList.remove('rotate-180');
            }
        }

        if (sortDropdownButton) {
            sortDropdownButton.addEventListener('click', (e) => {
                e.stopPropagation();
                toggleDropdown();
            });

            document.addEventListener('click', (e) => {
                if (!document.getElementById('customSortWrapper')?.contains(e.target)) {
                    toggleDropdown(false);
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') toggleDropdown(false);
            });
        }

        sortOptionItems.forEach(item => {
            item.addEventListener('click', () => {
                if (sortInternships) {
                    sortInternships.value = item.dataset.value;
                    sortInternships.dispatchEvent(new Event('change'));
                }
                toggleDropdown(false);
            });
        });

        if (sortInternships) {
            updateCustomDropdownUI(sortInternships.value || 'newest');

            sortInternships.addEventListener('change', () => {
                const url = new URL(window.location.href);
                url.searchParams.set('status', sortInternships.dataset.status || 'all');
                url.searchParams.set('sort', sortInternships.value);
                url.searchParams.delete('page');
                window.location.assign(url.toString());
            });
        }
    </script>
