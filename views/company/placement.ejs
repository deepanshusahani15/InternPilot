<% layout('layouts/boilerplate') %>
<%
    const statusLabel = String(placement.status || '').replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
    const canReview = (permissions || []).includes('applications:review');
    const evaluation = placement.companyEvaluation || {};
    const feedback = placement.candidateFeedback || {};
%>
<div class="mx-auto max-w-5xl space-y-6">
    <a href="/company/placements" class="inline-flex items-center gap-1 text-sm font-semibold text-indigo-700 hover:underline"><i class="ph-bold ph-arrow-left" aria-hidden="true"></i> All placements</a>
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Internship placement</p><h1 class="mt-1 text-2xl font-bold text-slate-900"><%= placement.candidate?.name || 'Candidate' %></h1><p class="mt-1 text-sm text-slate-600"><%= placement.internship?.title || 'Internship' %></p></div><span class="rounded-full bg-indigo-50 px-3 py-1.5 text-xs font-bold text-indigo-700"><%= statusLabel %></span></div><dl class="mt-5 grid gap-4 sm:grid-cols-3 text-sm"><div><dt class="text-xs text-slate-500">Start</dt><dd class="mt-1 font-bold text-slate-800"><%= new Date(placement.startDate).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %></dd></div><div><dt class="text-xs text-slate-500">Expected end</dt><dd class="mt-1 font-bold text-slate-800"><%= placement.endDate ? new Date(placement.endDate).toLocaleDateString('en-IN', { dateStyle: 'medium' }) : 'To be confirmed' %></dd></div><div><dt class="text-xs text-slate-500">Updates</dt><dd class="mt-1 font-bold text-slate-800"><%= (placement.progressUpdates || []).length %></dd></div></dl></section>

    <% if (canReview && placement.status === 'joined') { %><section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5"><h2 class="font-bold text-emerald-900">Candidate has joined</h2><p class="mt-1 text-sm text-emerald-800">Start the progress phase when internship work begins.</p><form action="/company/placements/<%= placement._id %>/start" method="POST" class="mt-4"><button class="rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-700">Start internship progress</button></form></section><% } %>

    <% if (canReview && placement.status === 'in_progress') { %>
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-bold text-slate-900">Add a progress update</h2><form action="/company/placements/<%= placement._id %>/progress" method="POST" class="mt-4 grid gap-3"><input name="title" required maxlength="160" placeholder="Milestone title" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm"><input type="date" name="milestoneDate" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm"><textarea name="details" required maxlength="4000" rows="4" placeholder="Progress or feedback for the candidate" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm"></textarea><button class="w-fit rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-indigo-700">Save update</button></form></section>
        <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-bold text-slate-900">Final company evaluation</h2><p class="mt-1 text-sm text-slate-600">A final evaluation and candidate feedback are required before completion.</p><form action="/company/placements/<%= placement._id %>/evaluation" method="POST" class="mt-4 grid gap-3"><label class="text-sm font-semibold text-slate-700">Rating <select name="rating" required class="ml-2 rounded-lg border border-slate-300 px-2 py-1"><option value="">Select</option><% [5,4,3,2,1].forEach(value => { %><option value="<%= value %>" <%= evaluation.rating === value ? 'selected' : '' %>><%= value %> / 5</option><% }) %></select></label><textarea name="strengths" maxlength="2000" rows="2" placeholder="Strengths" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm"><%= evaluation.strengths || '' %></textarea><textarea name="improvementAreas" maxlength="2000" rows="2" placeholder="Areas for improvement" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm"><%= evaluation.improvementAreas || '' %></textarea><textarea name="comments" maxlength="4000" rows="4" placeholder="Final comments" class="rounded-xl border border-slate-300 px-3 py-2.5 text-sm"><%= evaluation.comments || '' %></textarea><label class="text-sm text-slate-700"><input type="checkbox" name="recommendForFutureRoles" value="true" <%= evaluation.recommendForFutureRoles ? 'checked' : '' %>> Recommend for future roles</label><button class="w-fit rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-sm font-bold text-indigo-700 hover:bg-indigo-100">Save evaluation</button></form></section>
        <section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6"><h2 class="text-lg font-bold text-emerald-900">Complete placement</h2><p class="mt-1 text-sm text-emerald-800"><%= evaluation.submittedAt && feedback.submittedAt ? 'Both final inputs are ready. Completing will issue a verified certificate.' : 'Waiting for both the company evaluation and candidate feedback.' %></p><% if (evaluation.submittedAt && feedback.submittedAt) { %><form action="/company/placements/<%= placement._id %>/complete" method="POST" class="mt-4"><button class="rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-700">Complete and issue certificate</button></form><% } %></section>
    <% } %>

    <% if (placement.status === 'completed' && placement.certificate) { %><section class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6"><h2 class="text-lg font-bold text-emerald-900">Completed</h2><p class="mt-1 text-sm text-emerald-800">A verified certificate has been issued to the candidate.</p><a href="/certificates/<%= placement.certificate.certificateId %>/view" class="mt-4 inline-flex rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-700">View certificate</a></section><% } %>

    <% if (canReview && ['joining_pending', 'joined', 'in_progress'].includes(placement.status)) { %><section class="rounded-2xl border border-rose-200 bg-rose-50 p-6"><h2 class="text-lg font-bold text-rose-900">Terminate placement</h2><p class="mt-1 text-sm text-rose-800">This cannot be undone. A reason is required and the candidate will be notified.</p><form action="/company/placements/<%= placement._id %>/terminate" method="POST" class="mt-4 flex flex-col gap-3 sm:flex-row"><input name="reason" required maxlength="1000" placeholder="Reason for ending the placement" class="flex-1 rounded-xl border border-rose-300 bg-white px-3 py-2.5 text-sm"><button class="rounded-xl bg-rose-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-rose-700">Terminate</button></form></section><% } %>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-bold text-slate-900">Progress history</h2><% if (!(placement.progressUpdates || []).length) { %><p class="mt-3 text-sm text-slate-500">No progress updates yet.</p><% } else { %><ol class="mt-4 space-y-4"><% placement.progressUpdates.slice().reverse().forEach(update => { %><li class="border-l-2 border-indigo-200 pl-4"><div class="flex flex-wrap justify-between gap-2"><h3 class="font-bold text-slate-800"><%= update.title %></h3><time class="text-xs text-slate-500"><%= new Date(update.milestoneDate).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %></time></div><p class="mt-1 whitespace-pre-line text-sm text-slate-600"><%= update.details %></p></li><% }) %></ol><% } %></section>
</div>
